        function showFeedMessage(msg, color) {
            let container = document.getElementById('feed-container');
            let div = document.createElement('div');
            div.className = 'feed-msg';
            div.style.color = color;
            div.style.textShadow = `0 0 8px ${color}`;
            div.innerText = msg;
            container.appendChild(div);
            setTimeout(() => { if (div.parentNode) div.parentNode.removeChild(div); }, 1500);
        }

        function selectRole(role) {
            selectedRole = role;
            // Highlight whichever .role-card has a matching data-role attribute --
            // adding a new role-card in the HTML with the right data-role Just Works,
            // no JS change needed here.
            document.querySelectorAll('.role-card').forEach(card => {
                card.classList.toggle('selected', card.dataset.role === role);
            });
            // Re-apply the role's base speed (respects any "Sprinting Actuators" tier already bought).
            player.baseSpeed = ROLES[role].baseSpeed * (1 + (getTierBonus(upgradeTiers.playerSpeed, 10) / 100));
            player.speed = player.baseSpeed;
        }

        // Main menu "START RUN" -> role picker (roles are chosen after
        // pressing Start, not on the main menu itself).
        function showModeSelect() {
            document.getElementById('main-menu').style.display = 'none';
            document.getElementById('role-select-screen').style.display = 'none';
            document.getElementById('mode-select-screen').style.display = 'flex';
        }

        function hideModeSelect() {
            document.getElementById('mode-select-screen').style.display = 'none';
            document.getElementById('main-menu').style.display = 'flex';
        }

        function showRoleSelect() {
            document.getElementById('mode-select-screen').style.display = 'none';
            document.getElementById('role-select-screen').style.display = 'flex';
        }

        // Mode cards: Classic goes on to the role picker; the other two start
        // straight away with the shop pseudo-role.
        function chooseMode(mode) {
            if (mode === 'CLASSIC') { showRoleSelect(); return; }
            gameMode = mode;
            selectRole('SHOP');
            startGame();
        }

        function hideRoleSelect() {
            document.getElementById('role-select-screen').style.display = 'none';
            document.getElementById('mode-select-screen').style.display = 'flex';
        }

        // Picking a role card on the role-select screen locks it in and
        // launches the run immediately. Roles with no ROLES entry yet
        // (e.g. the standby "Jumper" card) aren't wired to this at all --
        // their card has no onclick -- so this only ever fires for a
        // fully implemented role.
        function chooseRole(role) {
            gameMode = 'CLASSIC';
            selectRole(role);
            startGame();
        }

        function toggleHowToPlay(show) {
            document.getElementById('howtoplay-modal').style.display = show ? 'flex' : 'none';
        }


        // =====================================================================
        // --- Mobile controls (only active in the mobile build) ---
        // Layout follows common phone FPS games: floating joystick on the
        // left half, drag-to-look on the right, big FIRE button (dragging
        // while holding it also aims), JUMP / SKILL / ULT / SWAP buttons in
        // an arc around it, a number pad for Kira. Buttons reuse the exact
        // keyboard code paths by dispatching the same key events.
        // =====================================================================
        function pressKey(code) { document.dispatchEvent(new KeyboardEvent('keydown', { code: code })); }
        function releaseKey(code) { document.dispatchEvent(new KeyboardEvent('keyup', { code: code })); }

        function applyLook(dx, dy) {
            const s = 0.0048 * mobileSens;
            camera.rotation.y -= dx * s;
            camera.rotation.x -= dy * s;
            camera.rotation.x = Math.max(-Math.PI / 2.3, Math.min(Math.PI / 2.3, camera.rotation.x));
        }

        let mobileLayerShown = false, mobileUi = {};
        const touchState = { joyId: null, joyX: 0, joyY: 0, lookId: null, lookX: 0, lookY: 0 };

        function resetTouchState() {
            touchState.joyId = null; touchState.lookId = null;
            mobileMove.x = 0; mobileMove.y = 0;
            isShooting = false;
            const jb = document.getElementById('joy-base'); if (jb) jb.style.display = 'none';
            ['KeyE', 'KeyF'].forEach(k => { if (mobileUi['held' + k]) { releaseKey(k); mobileUi['held' + k] = false; } });
        }

        function cycleWeapon() {
            const slots = ROLES[selectedRole].weaponSlots;
            const ids = Object.keys(slots).sort().map(k => slots[k]);
            if (ids.length < 2) return;
            const i = ids.indexOf(currentWeaponId);
            switchWeapon(ids[(i + 1) % ids.length]);
        }

        function initMobileControls() {
            document.documentElement.classList.add('mobile');
            const $ = (id) => document.getElementById(id);
            const layer = $('touch-layer'), base = $('joy-base'), knob = $('joy-knob');
            const JOY_R = 55;

            // ---- floating joystick (left) + look (right) on the open layer ----
            layer.addEventListener('pointerdown', (e) => {
                if (gameState !== 'PLAYING') return;
                e.preventDefault();
                try { layer.setPointerCapture(e.pointerId); } catch (err) {}
                if (e.clientX < window.innerWidth * 0.45 && touchState.joyId === null) {
                    touchState.joyId = e.pointerId; touchState.joyX = e.clientX; touchState.joyY = e.clientY;
                    base.style.left = e.clientX + 'px'; base.style.top = e.clientY + 'px'; base.style.display = 'block';
                    knob.style.transform = 'translate(0px, 0px)';
                } else if (e.clientX >= window.innerWidth * 0.45 && touchState.lookId === null) {
                    touchState.lookId = e.pointerId; touchState.lookX = e.clientX; touchState.lookY = e.clientY;
                }
            });
            layer.addEventListener('pointermove', (e) => {
                if (e.pointerId === touchState.joyId) {
                    let dx = e.clientX - touchState.joyX, dy = e.clientY - touchState.joyY;
                    const m = Math.hypot(dx, dy);
                    if (m > JOY_R) { dx *= JOY_R / m; dy *= JOY_R / m; }
                    knob.style.transform = 'translate(' + dx + 'px,' + dy + 'px)';
                    let nx = dx / JOY_R, ny = -dy / JOY_R;
                    if (Math.hypot(nx, ny) < 0.12) { nx = 0; ny = 0; } // dead zone
                    mobileMove.x = nx; mobileMove.y = ny;
                } else if (e.pointerId === touchState.lookId) {
                    applyLook(e.clientX - touchState.lookX, e.clientY - touchState.lookY);
                    touchState.lookX = e.clientX; touchState.lookY = e.clientY;
                }
            });
            const endTouch = (e) => {
                if (e.pointerId === touchState.joyId) { touchState.joyId = null; mobileMove.x = 0; mobileMove.y = 0; base.style.display = 'none'; }
                if (e.pointerId === touchState.lookId) touchState.lookId = null;
            };
            layer.addEventListener('pointerup', endTouch);
            layer.addEventListener('pointercancel', endTouch);

            // ---- buttons ----
            const hold = (btn, down, up, onMove) => {
                let pid = null, lx = 0, ly = 0;
                btn.addEventListener('pointerdown', (e) => {
                    e.preventDefault(); e.stopPropagation();
                    if (gameState !== 'PLAYING') return;
                    pid = e.pointerId; lx = e.clientX; ly = e.clientY;
                    try { btn.setPointerCapture(e.pointerId); } catch (err) {}
                    btn.classList.add('pressed'); down();
                });
                btn.addEventListener('pointermove', (e) => {
                    if (onMove && e.pointerId === pid) { onMove(e.clientX - lx, e.clientY - ly); lx = e.clientX; ly = e.clientY; }
                });
                const end = (e) => {
                    e.stopPropagation();
                    if (e.pointerId !== pid) return;
                    pid = null; btn.classList.remove('pressed'); if (up) up();
                };
                btn.addEventListener('pointerup', end);
                btn.addEventListener('pointercancel', end);
            };

            hold($('tb-fire'), () => { isShooting = true; }, () => { isShooting = false; }, (dx, dy) => applyLook(dx, dy)); // drag while firing to aim
            hold($('tb-jump'), () => triggerJump(), null);
            hold($('tb-skill'), () => { mobileUi.heldKeyE = true; pressKey('KeyE'); }, () => { mobileUi.heldKeyE = false; releaseKey('KeyE'); });
            hold($('tb-ult'), () => { mobileUi.heldKeyF = true; pressKey('KeyF'); }, () => { mobileUi.heldKeyF = false; releaseKey('KeyF'); });
            hold($('tb-swap'), () => cycleWeapon(), null);
            hold($('tb-pause'), () => { resetTouchState(); pauseGame(); }, null);
            document.querySelectorAll('#kira-pad .tbtn').forEach(b => {
                const t = b.innerText;
                if (t === '.') return;
                hold(b, () => pressKey(t === 'DEL' ? 'Backspace' : 'Digit' + t), null);
            });

            // ---- phone-specific text + pause-menu sensitivity slider ----
            const cs = $('controls-sec');
            if (cs) cs.innerHTML = '<h3>CONTROLS</h3><b>Left thumb</b> - drag anywhere on the left to move (floating joystick)<br>' +
                '<b>Right thumb</b> - drag on the right to look around<br><b>FIRE</b> - hold to shoot / slash (drag while holding to aim)<br>' +
                '<b>JUMP</b>, <b>SKILL</b> (hold to aim for Jumper), <b>ULT</b> (glows when charged), <b>SWAP</b> weapons, <b>II</b> pause<br>' +
                '<b>Kira</b> - tap the number pad to type the number above an enemy';
            try { const saved = parseFloat(localStorage.getItem('gsc_sens')); if (saved > 0) mobileSens = saved; } catch (err) {}
            const ps = $('pause-screen');
            const wrap = document.createElement('div');
            wrap.style.cssText = 'color:#00ffff;font:12px sans-serif;margin:6px;text-align:center;';
            wrap.innerHTML = 'LOOK SENSITIVITY <input type="range" id="sens-range" min="0.4" max="2.5" step="0.1" value="' + mobileSens + '" style="vertical-align:middle;width:140px;">';
            ps.appendChild(wrap);
            const rng = wrap.querySelector('#sens-range');
            rng.addEventListener('input', () => { mobileSens = parseFloat(rng.value); try { localStorage.setItem('gsc_sens', String(mobileSens)); } catch (err) {} });

            // auto-pause when the app/tab goes to the background
            document.addEventListener('visibilitychange', () => { if (document.hidden && gameState === 'PLAYING') { resetTouchState(); pauseGame(); } });
            // block the long-press menu and pinch gestures on the game
            document.addEventListener('contextmenu', (e) => e.preventDefault());
            document.addEventListener('gesturestart', (e) => e.preventDefault());
        }

        // Per-frame: show/hide the touch layer and the buttons that apply to this role/loadout.
        function setMobileDisplay(id, shown, display) {
            if (mobileUi[id] === shown) return;
            mobileUi[id] = shown;
            document.getElementById(id).style.display = shown ? (display || 'block') : 'none';
        }
        function updateMobileUI() {
            const playing = (gameState === 'PLAYING');
            if (playing !== mobileLayerShown) {
                mobileLayerShown = playing;
                document.getElementById('touch-layer').style.display = playing ? 'block' : 'none';
                if (!playing) resetTouchState();
            }
            if (!playing) return;
            const rc = ROLES[selectedRole] || {};
            const isKira = selectedRole === 'KIRA';
            setMobileDisplay('kira-pad', isKira, 'block');
            setMobileDisplay('tb-fire', !isKira);
            setMobileDisplay('tb-swap', !isKira && Object.keys(rc.weaponSlots || {}).length > 1);
            setMobileDisplay('tb-skill', !!rc.onSkillE);
            setMobileDisplay('tb-ult', !!(rc.onUltimate || rc.holdableUltimate));
            const ready = player.ultCharge >= player.ultRequiredKills;
            if (mobileUi.ultReady !== ready) { mobileUi.ultReady = ready; document.getElementById('tb-ult').classList.toggle('ready', ready); }
        }

        function pauseGame() {
            if (gameState === "PLAYING") {
                gameState = "PAUSED";
                document.getElementById('pause-screen').style.display = 'flex';
            }
        }

        function resumeGame() {
            document.getElementById('pause-screen').style.display = 'none';
            gameState = "PLAYING";
            document.body.requestPointerLock();
        }

        function quitToMenu() {
            document.getElementById('pause-screen').style.display = 'none';
            setHUDVisibility('none');
            document.getElementById('boss-ui').style.display = 'none';
            document.getElementById('main-menu').style.display = 'flex';
            gameState = "MENU";
        }

        // Phones have no pointer lock: make every requestPointerLock/exitPointerLock
        // call in the game a harmless no-op there.
        if (IS_MOBILE) {
            document.body.requestPointerLock = function () {};
            document.exitPointerLock = function () {};
        }

        document.addEventListener('pointerlockchange', () => {
            if (document.pointerLockElement !== document.body && gameState === "PLAYING") {
                pauseGame();
            }
        });

        let moveForward = false, moveBackward = false, moveLeft = false, moveRight = false;

        document.body.addEventListener('click', () => { 
            if (gameState === "PLAYING") document.body.requestPointerLock(); 
        });

        document.addEventListener('keydown', (e) => {
            if (e.code === 'Escape' && gameState === "PLAYING") {
                pauseGame(); return;
            }
            if (gameState !== "PLAYING") return;
            if (e.repeat) return; // ignore OS key-repeat -- skills should only trigger once per physical press

            // --- Kira Specific: Death Note number entry ---
            // Digit keys are repurposed entirely as typed input for this
            // role, so they're intercepted here before the normal
            // weapon-switch cases below ever see them.
            if (selectedRole === 'KIRA') {
                if (/^Digit[0-9]$/.test(e.code)) { handleKiraDigitInput(e.code.slice(5)); return; }
                if (e.code === 'Backspace') { player.kiraTypedBuffer = player.kiraTypedBuffer.slice(0, -1); return; }
            }

            switch (e.code) {
                case 'KeyW': moveForward = true; break;
                case 'KeyS': moveBackward = true; break;
                case 'KeyA': moveLeft = true; break;
                case 'KeyD': moveRight = true; break;
                case 'Space': triggerJump(); break;
                case 'KeyE': triggerDashOrSkill(); break;
                case 'KeyQ': triggerSecondarySkill(); break;
                case 'KeyF': triggerUltimateAbility(); break;
                case 'Digit2': { let wId = ROLES[selectedRole].weaponSlots[2]; if (wId) switchWeapon(wId); break; }
                case 'Digit4': { let wId = ROLES[selectedRole].weaponSlots[4]; if (wId) switchWeapon(wId); break; }
                case 'Digit1': { let wId = ROLES[selectedRole].weaponSlots[1]; if (wId) switchWeapon(wId); break; }
                case 'Digit3': { let wId = ROLES[selectedRole].weaponSlots[3]; if (wId) switchWeapon(wId); break; }
            }
        });

        document.addEventListener('keyup', (e) => {
            switch (e.code) {
                case 'KeyW': moveForward = false; break;
                case 'KeyS': moveBackward = false; break;
                case 'KeyA': moveLeft = false; break;
                case 'KeyD': moveRight = false; break;
                // Both roles' held-cast abilities (currently just Jumper's Warp
                // Blink/Gravity Slam) resolve on release; every other role's
                // E/F are instant-on-press and simply have no release hook.
                case 'KeyE': releaseSkillE(); break;
                case 'KeyF': releaseUltimateHold(); break;
            }
        });

        document.addEventListener('mousemove', (e) => {
            if (document.pointerLockElement !== document.body || gameState !== "PLAYING") return;
            camera.rotation.y -= e.movementX * 0.0025;
            camera.rotation.x -= e.movementY * 0.0025;
            camera.rotation.x = Math.max(-Math.PI / 2.3, Math.min(Math.PI / 2.3, camera.rotation.x));
        });

        document.addEventListener('mousedown', (e) => { if (document.pointerLockElement === document.body && e.button === 0 && gameState === "PLAYING") isShooting = true; });
        document.addEventListener('mouseup', (e) => { if (e.button === 0) isShooting = false; });

        init();
        animate();

        function init() {
            scene = new THREE.Scene();
            scene.background = new THREE.Color(0x040108); 
            scene.fog = new THREE.FogExp2(0x040108, 0.045); 

            camera = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, 0.1, 2000);
            camera.rotation.order = 'YXZ'; 

            scene.add(new THREE.AmbientLight(0x222244));
            
            renderer = new THREE.WebGLRenderer({ antialias: !IS_MOBILE });
            renderer.setSize(window.innerWidth, window.innerHeight);
            document.getElementById('canvas-container').appendChild(renderer.domElement);

            const floorGeo = new THREE.PlaneGeometry(1000, 1000);
            const floorMat = new THREE.MeshLambertMaterial({ color: 0x0c051c });
            let floor = new THREE.Mesh(floorGeo, floorMat);
            floor.rotation.x = -Math.PI / 2;
            scene.add(floor);

            window.addEventListener('resize', onWindowResize);
            if (IS_MOBILE) initMobileControls();
            else if (window.matchMedia && matchMedia('(pointer: coarse)').matches && !matchMedia('(pointer: fine)').matches) document.getElementById('pc-banner').style.display = 'block';
        }

        // Wipes every piece of per-run state so a new run (first start, restart
        // after game over, or starting again after quitting to the menu) never
        // inherits upgrades, stats or cooldowns from the previous one.
        function resetRunState() {
            player.score = 0; currentLevel = 1; mazeSize = 11; player.slowTimeLeft = 0;
            player.maxHealth = 100; player.health = 100; player.fireRateModifier = 1.0; player.damageModifier = 1.0; player.killSpeedBonusPct = 0;
            player.dashMultiplier = 1.0; player.dashCooldown = 0; player.dashCooldownMax = 4.0; player.dashMomentum.set(0, 0, 0);
            player.phantomActive = false; player.phantomCdLeft = 0; player.phantomSpeedBoostTimeLeft = 0;
            player.phantomWindowMax = PHANTOM_WINDOW_DURATION; player.ultCastEffectTimeLeft = 0;
            player.jumperAimHeld = false; player.jumperUltAimHeld = false; player.jumperBlinkCdLeft = 0;
            player.jumperBlinkRange = JUMPER_AIM_MAX_RANGE_BASE; player.jumperBlinkCdMax = 3.0;
            hideJumperAimMarker();
            fovKickTimeLeft = 0; kiraTimeSlowTimeLeft = 0; kiraSlowDuration = KIRA_TIME_SLOW_DURATION;
            player.kiraTypedBuffer = "";
            player.ultCharge = 0; bossRoundMultiplier = 1;
            recoilPitch = 0; recoilYaw = 0;
            onKillBuffs = { killCount: 0, timer: 0 };
            for (let k in upgradeTiers) upgradeTiers[k] = 0;

            shopLoadout = { skill: null, ult: null }; shopSpent = {}; shopItemTier = {}; shopWeapons = []; tdPad = null;
            td.active = false; td.wave = 0; td.waveActive = false; td.shopPending = false;
            baseFogDensity = (gameMode === 'TD') ? 0.016 : 0.045;
            scene.fog.density = baseFogDensity;

            WEAPONS[1].damage = 40; WEAPONS[1].fireRate = 0.25; WEAPONS[1].reserve = Infinity;
            WEAPONS[2].damage = 180;
            WEAPONS[3].maxReserve = 40; WEAPONS[3].reserve = 15; WEAPONS[3].pelletCount = 9; WEAPONS[3].spread = 0.14; WEAPONS[3].damage = 20; WEAPONS[3].fireRate = 0.75;
            WEAPONS[4].splashRadius = 4.0; WEAPONS[4].damage = 450;
            WEAPONS[5].damage = 500; WEAPONS[5].width = 4.5;
            WEAPONS[6].damage = 18;
            WEAPONS[7].damage = 65; WEAPONS[7].radius = 6;

            player.baseSpeed = ROLES[selectedRole].baseSpeed; player.speed = player.baseSpeed;
            currentWeaponId = ROLES[selectedRole].defaultWeaponId;
            player.timeLeft = 40;
        }

        function beginRunLevel() {
            if (gameMode === 'TD') setupTDLevel();
            else generateNextLevel();
        }

        function applyModeHUD() {
            const isTD = (gameMode === 'TD');
            document.getElementById('timer-display').style.display = isTD ? 'none' : 'block';
            document.getElementById('td-ui').style.display = isTD ? 'block' : 'none';
            document.getElementById('level-info').innerHTML = (isTD ? 'WAVE' : 'STAGE') + ' <span id="level-counter">1</span>';
        }

        function finishRunStart() {
            document.getElementById('loading-screen').style.display = 'none';
            setHUDVisibility('block');
            applyModeHUD();
            updateUI();
            if (gameMode === 'TD') {
                // Crystal Defense opens with a prep shop and a small starting purse.
                player.score = 400;
                updateUI();
                openShop('PREP');
            } else {
                gameState = "PLAYING";
                document.body.requestPointerLock();
            }
        }

        // Mobile: go fullscreen + landscape on the first tap (needs a user gesture).
        function enterMobileFullscreen() {
            try {
                const el = document.documentElement;
                const req = el.requestFullscreen || el.webkitRequestFullscreen;
                if (req) { const r = req.call(el); if (r && r.catch) r.catch(() => {}); }
                if (screen.orientation && screen.orientation.lock) screen.orientation.lock('landscape').catch(() => {});
            } catch (e) { /* not supported (e.g. iOS Safari): the rotate hint still applies */ }
        }

        function startGame() {
            if (IS_MOBILE) enterMobileFullscreen();
            document.getElementById('main-menu').style.display = 'none';
            document.getElementById('mode-select-screen').style.display = 'none';
            document.getElementById('role-select-screen').style.display = 'none';
            document.getElementById('loading-screen').style.display = 'flex';

            setTimeout(() => {
                resetRunState();
                buildWeaponMesh();
                beginRunLevel();
                finishRunStart();
            }, 100);
        }

        function setHUDVisibility(state) {
            if (state === 'none') document.getElementById('td-ui').style.display = 'none';
            document.getElementById('ui').style.display = state;
            document.getElementById('timer-display').style.display = state;
            document.getElementById('weapon-info').style.display = state;
            document.getElementById('level-info').style.display = state;
            document.getElementById('crosshair').style.display = state;
            document.getElementById('skill-ui').style.display = state;
            document.getElementById('buff-ui').style.display = state;
            document.getElementById('ult-ui').style.display = state;
        }

        function buildWeaponMesh() {
            if (weaponMesh) camera.remove(weaponMesh);
            weaponMesh = new THREE.Group();

            if (currentWeaponId === 2) { 
                const handleGeo = new THREE.CylinderGeometry(0.02, 0.02, 0.35, 8);
                const handleMat = new THREE.MeshBasicMaterial({ color: 0x222222 });
                const handle = new THREE.Mesh(handleGeo, handleMat);
                weaponMesh.add(handle);

                const bladeGeo = new THREE.BoxGeometry(0.015, 0.85, 0.06);
                const bladeMat = new THREE.MeshBasicMaterial({ color: 0x00ffaa });
                const blade = new THREE.Mesh(bladeGeo, bladeMat);
                blade.position.set(0, 0.45, -0.05);
                weaponMesh.add(blade);

                weaponMesh.position.set(0.3, -0.3, -0.5);
                weaponMesh.rotation.set(0.2, -0.4, 0); 
            } else if (currentWeaponId === 1) {
                // --- Infinity Pistol viewmodel: slide with serrations and sights,
                // separate frame, angled grip, trigger + guard, glowing accent strip.
                const accent = new THREE.MeshBasicMaterial({ color: WEAPONS[1].color });
                const slideMat = new THREE.MeshBasicMaterial({ color: 0x2b333d });
                const frameMat = new THREE.MeshBasicMaterial({ color: 0x15191f });
                const gripMat = new THREE.MeshBasicMaterial({ color: 0x0e1116 });
                const steel = new THREE.MeshBasicMaterial({ color: 0x8c9aa8 });
                const part = (geo, mat, x, y, z, rx) => { const m = new THREE.Mesh(geo, mat); m.position.set(x, y, z); if (rx) m.rotation.x = rx; weaponMesh.add(m); return m; };

                part(new THREE.BoxGeometry(0.066, 0.076, 0.34), slideMat, 0, 0.05, -0.02);          // slide
                part(new THREE.BoxGeometry(0.026, 0.008, 0.28), accent, 0, 0.092, -0.03);            // glowing top strip
                for (let k = 0; k < 4; k++) part(new THREE.BoxGeometry(0.07, 0.06, 0.008), frameMat, 0, 0.05, 0.08 + k * 0.022); // rear serrations
                part(new THREE.BoxGeometry(0.06, 0.04, 0.3), frameMat, 0, 0.0, -0.01);               // frame
                const barrel = part(new THREE.CylinderGeometry(0.017, 0.017, 0.09, 10), steel, 0, 0.05, -0.215); barrel.rotation.x = Math.PI / 2; // barrel
                const muzzle = part(new THREE.CylinderGeometry(0.024, 0.024, 0.014, 10), accent, 0, 0.05, -0.262); muzzle.rotation.x = Math.PI / 2; // muzzle ring
                part(new THREE.BoxGeometry(0.012, 0.022, 0.016), accent, 0, 0.104, -0.17);           // front sight
                part(new THREE.BoxGeometry(0.012, 0.02, 0.014), frameMat, -0.018, 0.103, 0.13);      // rear sight L
                part(new THREE.BoxGeometry(0.012, 0.02, 0.014), frameMat, 0.018, 0.103, 0.13);       // rear sight R
                part(new THREE.BoxGeometry(0.012, 0.026, 0.02), steel, 0, 0.09, 0.175);              // hammer
                part(new THREE.BoxGeometry(0.058, 0.15, 0.078), gripMat, 0, -0.095, 0.125, 0.28);    // grip
                part(new THREE.BoxGeometry(0.062, 0.02, 0.09), slideMat, 0, -0.178, 0.148, 0.28);    // magazine base
                part(new THREE.BoxGeometry(0.01, 0.1, 0.05), accent, 0.031, -0.09, 0.125, 0.28);     // grip accent panel
                part(new THREE.BoxGeometry(0.01, 0.028, 0.012), accent, 0, -0.03, 0.03);             // trigger
                const guard = part(new THREE.TorusGeometry(0.034, 0.006, 6, 12, Math.PI), frameMat, 0, -0.022, 0.035); guard.rotation.x = Math.PI / 2; // trigger guard

                weaponMesh.position.set(0.2, -0.22, -0.45);
            } else if (currentWeaponId === 3) { 
                // --- Shotgunner Specific: Cyber Shotgun viewmodel ---
                const bodyMat = new THREE.MeshBasicMaterial({ color: 0x112211 });
                const barrelMat = new THREE.MeshBasicMaterial({ color: WEAPONS[3].color });
                const darkMat = new THREE.MeshBasicMaterial({ color: 0x0a0a0a });

                const receiver = new THREE.Mesh(new THREE.BoxGeometry(0.1, 0.11, 0.22), bodyMat);
                weaponMesh.add(receiver);

                const barrel = new THREE.Mesh(new THREE.CylinderGeometry(0.03, 0.03, 0.55, 8), barrelMat);
                barrel.rotation.x = Math.PI / 2;
                barrel.position.set(0, 0.02, -0.38);
                weaponMesh.add(barrel);

                const pump = new THREE.Mesh(new THREE.BoxGeometry(0.06, 0.06, 0.16), darkMat);
                pump.position.set(0, -0.03, -0.3);
                weaponMesh.add(pump);

                const stock = new THREE.Mesh(new THREE.BoxGeometry(0.07, 0.09, 0.22), darkMat);
                stock.position.set(0, -0.015, 0.2);
                weaponMesh.add(stock);

                weaponMesh.position.set(0.2, -0.22, -0.45);
            } else if (currentWeaponId === 4) {
                // --- Shotgunner Specific: Hyper RPG viewmodel ---
                const tubeMat = new THREE.MeshBasicMaterial({ color: 0x333333 });
                const tipMat = new THREE.MeshBasicMaterial({ color: WEAPONS[4].color });

                const tube = new THREE.Mesh(new THREE.CylinderGeometry(0.1, 0.1, 0.9, 10), tubeMat);
                tube.rotation.x = Math.PI / 2;
                weaponMesh.add(tube);

                const tip = new THREE.Mesh(new THREE.ConeGeometry(0.11, 0.22, 10), tipMat);
                tip.rotation.x = -Math.PI / 2;
                tip.position.set(0, 0, -0.55);
                weaponMesh.add(tip);

                const grip = new THREE.Mesh(new THREE.BoxGeometry(0.05, 0.14, 0.06), tubeMat);
                grip.position.set(0, -0.12, 0.1);
                weaponMesh.add(grip);

                const sight = new THREE.Mesh(new THREE.BoxGeometry(0.02, 0.06, 0.02), tipMat);
                sight.position.set(0, 0.13, -0.1);
                weaponMesh.add(sight);

                weaponMesh.position.set(0.22, -0.25, -0.6);
            } else if (currentWeaponId === 6) {
                // --- Jumper Specific: Phase Carbine viewmodel ---
                const bodyMat = new THREE.MeshBasicMaterial({ color: 0x1a1a22 });
                const accentMat = new THREE.MeshBasicMaterial({ color: WEAPONS[6].color });

                const receiver = new THREE.Mesh(new THREE.BoxGeometry(0.08, 0.09, 0.4), bodyMat);
                weaponMesh.add(receiver);

                const barrel = new THREE.Mesh(new THREE.CylinderGeometry(0.018, 0.018, 0.3, 8), accentMat);
                barrel.rotation.x = Math.PI / 2;
                barrel.position.set(0, 0.015, -0.33);
                weaponMesh.add(barrel);

                const mag = new THREE.Mesh(new THREE.BoxGeometry(0.035, 0.18, 0.06), bodyMat);
                mag.position.set(0, -0.12, -0.02);
                mag.rotation.x = -0.25;
                weaponMesh.add(mag);

                const stock = new THREE.Mesh(new THREE.BoxGeometry(0.05, 0.06, 0.18), bodyMat);
                stock.position.set(0, 0, 0.27);
                weaponMesh.add(stock);

                const foregrip = new THREE.Mesh(new THREE.BoxGeometry(0.03, 0.08, 0.03), accentMat);
                foregrip.position.set(0, -0.08, -0.2);
                weaponMesh.add(foregrip);

                weaponMesh.position.set(0.2, -0.24, -0.45);
            } else if (currentWeaponId === 8) {
                // --- Kira Specific: Death Note viewmodel (cosmetic only) ---
                weaponMesh.add(new THREE.Mesh(new THREE.BoxGeometry(0.28, 0.38, 0.04), new THREE.MeshBasicMaterial({ color: 0x0a0a0a })));
                const page = new THREE.Mesh(new THREE.BoxGeometry(0.24, 0.34, 0.01), new THREE.MeshBasicMaterial({ color: 0xf2f2e6 }));
                page.position.z = 0.03;
                weaponMesh.add(page);
                weaponMesh.position.set(0.22, -0.28, -0.45);
                weaponMesh.rotation.set(0.1, -0.15, 0);
            } else {
                const wData = WEAPONS[currentWeaponId];
                if (wData && wData.size) {
                    const baseGeo = new THREE.BoxGeometry(...wData.size);
                    const baseMat = new THREE.MeshBasicMaterial({ color: wData.color });
                    weaponMesh.add(new THREE.Mesh(baseGeo, baseMat));
                }
                weaponMesh.position.set(0.2, -0.22, -0.45);
            }

            camera.add(weaponMesh);
            scene.add(camera);
        }

        function switchWeapon(id) {
            if (id === currentWeaponId) return;
            currentWeaponId = id;
            buildWeaponMesh();
            updateUI();
        }

        function triggerDashOrSkill() {
            const roleCfg = ROLES[selectedRole];
            if (roleCfg && roleCfg.onSkillE) roleCfg.onSkillE();
        }

        // Fires on E release. Only relevant to roles whose E is a hold-to-aim
        // skill (currently just Jumper's Warp Blink); every other role's E
        // is instant-on-press and has no onSkillERelease, so this no-ops.
        function releaseSkillE() {
            const roleCfg = ROLES[selectedRole];
            if (roleCfg && roleCfg.onSkillERelease) roleCfg.onSkillERelease();
        }

        // Q-key secondary skill: no role has one right now, but the hook
        // stays so a future role can add an onSkillQ without touching input code.
        function triggerSecondarySkill() {
            const roleCfg = ROLES[selectedRole];
            if (roleCfg && roleCfg.onSkillQ) roleCfg.onSkillQ();
        }

        // --- Shotgunner Specific: Kinetic Dash ---
        // Standalone skill on a cooldown (no Overclock needed any more).
        // Any kill instantly refreshes it (see ROLES.SHOTGUNNER.onKill).
        // Keyboard (WASD) or, on mobile, the virtual joystick.
        function getMoveInput() {
            let f = (moveForward ? 1 : 0) - (moveBackward ? 1 : 0), s = (moveRight ? 1 : 0) - (moveLeft ? 1 : 0);
            if (IS_MOBILE && (mobileMove.x !== 0 || mobileMove.y !== 0)) { s = mobileMove.x; f = mobileMove.y; }
            return { f: f, s: s };
        }

        function triggerKineticDash() {
            if (player.dashCooldown > 0) return;

            const mi = getMoveInput();
            let fDir = mi.f;
            let sDir = mi.s;
            if (fDir === 0 && sDir === 0) fDir = 1;

            let dir = new THREE.Vector3(sDir, 0, -fDir).normalize().applyQuaternion(camera.quaternion);
            dir.y = 0; dir.normalize();

            let dashPower = 28.0 * player.dashMultiplier;
            player.dashMomentum.copy(dir).multiplyScalar(dashPower);
            player.dashCooldown = player.dashCooldownMax;
            showFeedMessage("KINETIC DASH!", "#00ffff");
        }

        // HUD text for Kinetic Dash (the cooldown itself ticks in animate()).
        function updateKineticDash(delta, skillElement) {
            skillElement.innerText = player.dashCooldown > 0
                ? `DASH CD: ${player.dashCooldown.toFixed(1)}s`
                : `SKILL [E]: KINETIC DASH READY`;
        }

        // --- Assassin Specific: Phantom Rush ---
        // Press E: for PHANTOM_WINDOW_DURATION seconds the player moves at
        // hyper speed (fully WASD-steered). There's no auto-slash anymore --
        // damage comes entirely from manual Katana swings (see shoot()) --
        // but every kill landed while the window is active refreshes it back
        // to a fresh PHANTOM_WINDOW_DURATION, so a player who keeps
        // connecting can chain the window indefinitely. If it ever runs out
        // without a recent kill to refresh it, Phantom Rush ends; whether any
        // kill happened at all during the activation decides the cooldown.
        function triggerPhantomDash() {
            if (player.phantomActive || player.phantomCdLeft > 0) return;

            player.phantomActive = true;
            player.phantomWindowTimeLeft = player.phantomWindowMax;
            player.phantomKilledDuringWindow = false;
            showFeedMessage("HYPER SPEED!", "#00ffaa");
        }

        // --- Assassin Specific: kill hook for Phantom Rush ---
        // Kills from ANY source (katana, bullets, abilities) refresh the
        // window to full and count towards the "got a kill" instant-recharge.
        function onPhantomKill() {
            if (!player.phantomActive) return;
            player.phantomWindowTimeLeft = player.phantomWindowMax;
            player.phantomKilledDuringWindow = true;
        }

        // --- Assassin Specific: per-frame Phantom Rush update ---
        // Counts down the hyper-speed window, or -- when idle -- ticks the
        // cooldown / post-window speed boost. Does NOT reset fov/speed
        // defaults; the caller does that once per frame so several skill
        // pieces can layer on top of each other (needed by the shop mode).
        function updatePhantomRush(delta, skillElement) {
            if (player.phantomActive) {
                camera.fov = 95;
                player.speed = player.baseSpeed * PHANTOM_HYPER_SPEED_MULT;

                player.phantomWindowTimeLeft -= delta;
                skillElement.innerText = `HYPER SPEED: ${Math.max(0, player.phantomWindowTimeLeft).toFixed(1)}s`;

                if (player.phantomWindowTimeLeft <= 0) {
                    player.phantomActive = false;
                    player.phantomSpeedBoostTimeLeft = PHANTOM_SPEED_BOOST_DURATION;
                    if (player.phantomKilledDuringWindow) {
                        player.phantomCdLeft = 0;
                        showFeedMessage("KILL STREAK! INSTANT RECHARGE", "#00ffaa");
                    } else {
                        player.phantomCdLeft = PHANTOM_MISS_COOLDOWN;
                        showFeedMessage("NO KILLS -> COOLDOWN", "#ff0055");
                    }
                }
            } else {
                if (player.phantomSpeedBoostTimeLeft > 0) {
                    player.phantomSpeedBoostTimeLeft -= delta;
                    player.speed = player.baseSpeed * PHANTOM_SPEED_BOOST_MULT;
                }

                if (player.phantomCdLeft > 0) {
                    player.phantomCdLeft -= delta;
                    skillElement.innerText = `PHANTOM CD: ${player.phantomCdLeft.toFixed(1)}s`;
                } else {
                    skillElement.innerText = (player.phantomSpeedBoostTimeLeft > 0)
                        ? `SKILL [E]: READY (+20% SPD ${player.phantomSpeedBoostTimeLeft.toFixed(1)}s)`
                        : `SKILL [E]: HYPER SPEED READY`;
                }
            }
        }

        // --- Assassin Specific: Blade Wave cast punch ---
        // The ultimate no longer fires the instant F is pressed: the camera
        // zooms in and the player slows for ASSASSIN_ULT_FX_DURATION, the
        // katana comes down in a vertical chop, and ONLY THEN does the wave
        // launch. Returns true while the cast is in progress so callers can
        // pause their own skill logic for that moment.
        function updateBladeWaveFx(delta, skillElement) {
            if (player.ultCastEffectTimeLeft <= 0) return false;
            player.ultCastEffectTimeLeft -= delta;
            let t = Math.max(0, player.ultCastEffectTimeLeft / ASSASSIN_ULT_FX_DURATION); // 1 -> 0
            camera.fov = ASSASSIN_ULT_FX_FOV + (75 - ASSASSIN_ULT_FX_FOV) * (1 - t);
            player.speed = player.baseSpeed * ASSASSIN_ULT_FX_SPEED_MULT;
            skillElement.innerText = `BLADE WAVE...`;
            if (player.ultCastEffectTimeLeft <= 0) launchBladeWave();
            return true;
        }

        function updateAssassinSkill(delta, skillElement) {
            baseFrameDefaults();
            if (!updateBladeWaveFx(delta, skillElement)) updatePhantomRush(delta, skillElement);
            camera.updateProjectionMatrix();
        }

        // Shared per-frame reset every role/loadout update starts from, so
        // each piece below only has to apply what is different while active.
        function baseFrameDefaults() {
            camera.fov = 75;
            player.speed = player.baseSpeed;
        }

        // --- Shotgunner Specific: per-frame update ---
        function updateShotgunnerSkill(delta, skillElement) {
            baseFrameDefaults();
            updateKineticDash(delta, skillElement);
            camera.updateProjectionMatrix();
        }

        // =====================================================================
        // --- Jumper Specific: Warp Blink [E] + Gravity Slam ultimate [F] ---
        // Both abilities share one aim-cast system: hold the key, a marker
        // appears wherever your crosshair currently points (projected onto
        // the floor, capped at player.jumperBlinkRange), turning green over
        // legal ground and red over a wall or outside the level. Releasing
        // while green confirms (Blink warps you there; Slam detonates AND
        // warps you there); releasing on red cancels for free.
        // =====================================================================

        let jumperAimMarkerMesh = null, jumperAimMarkerMats = [];

        function ensureJumperAimMarker() {
            if (jumperAimMarkerMesh) return;
            jumperAimMarkerMesh = new THREE.Group();

            const ringMat = new THREE.MeshBasicMaterial({ color: 0x00ff66, transparent: true, opacity: 0.9, depthTest: false, side: THREE.DoubleSide });
            const ring = new THREE.Mesh(new THREE.RingGeometry(0.35, 0.55, 24), ringMat);
            ring.rotation.x = -Math.PI / 2;
            jumperAimMarkerMesh.add(ring);

            const pillarMat = new THREE.MeshBasicMaterial({ color: 0x00ff66, transparent: true, opacity: 0.35, depthTest: false });
            const pillar = new THREE.Mesh(new THREE.CylinderGeometry(0.05, 0.05, 3.2, 6), pillarMat);
            pillar.position.y = 1.6;
            jumperAimMarkerMesh.add(pillar);

            jumperAimMarkerMats = [ringMat, pillarMat];
            jumperAimMarkerMesh.visible = false;
            jumperAimMarkerMesh.renderOrder = 999;
            scene.add(jumperAimMarkerMesh);
        }

        function showJumperAimMarker(x, z, valid) {
            ensureJumperAimMarker();
            jumperAimMarkerMesh.visible = true;
            jumperAimMarkerMesh.position.set(x, 0.05, z);
            let color = valid ? 0x00ff66 : 0xff2244;
            jumperAimMarkerMats.forEach(m => m.color.setHex(color));
        }

        function hideJumperAimMarker() {
            if (jumperAimMarkerMesh) jumperAimMarkerMesh.visible = false;
        }

        // Where the crosshair is currently pointing, projected onto the
        // floor and capped at maxRange -- recomputed fresh every call, so
        // the marker tracks your aim directly instead of ramping over time.
        // Looking down far enough hits the floor at some distance (used as
        // long as it's inside maxRange); looking level or upward has no
        // floor intersection, so the point defaults to the full range along
        // the flattened look direction instead.
        function computeJumperAimPoint(maxRange) {
            let dir = new THREE.Vector3(0, 0, -1).applyQuaternion(camera.quaternion).normalize();
            let dist;
            if (dir.y < -0.001) {
                dist = Math.min(-camera.position.y / dir.y, maxRange);
            } else {
                dist = maxRange;
            }
            return { x: camera.position.x + dir.x * dist, z: camera.position.z + dir.z * dist, dist: dist };
        }

        // A destination is legal if it's inside the level's playable
        // footprint AND not embedded in any wall's box -- both checks are
        // needed: the wall check alone would happily accept a point that
        // overshot the boundary into the void beyond the level.
        // The boss arena is a completely different layout from the regular
        // maze (a circular ring of pillars around the origin, not a grid --
        // see generateNextLevel's isBossStage branch), so it needs its own
        // footprint check; using the maze's rectangular formula there was
        // the bug that made every skill read as "outside the map" on boss
        // stages, since mazeOffset is reset to 0 and the maze grid variables
        // no longer describe the arena at all.
        function isJumperDestinationValid(x, z) {
            if (gameMode === 'TD') {
                if (Math.hypot(x, z) > 70) return false;
            } else if (isBossStage) {
                const ARENA_SAFE_RADIUS = 24; // just inside the ring of pillar walls, which sit at radius 26
                if (Math.hypot(x, z) > ARENA_SAFE_RADIUS) return false;
            } else {
                let minCoord = (1 * cellSize) - mazeOffset - cellSize * 0.5;
                let maxCoord = ((mazeSize - 2) * cellSize) - mazeOffset + cellSize * 0.5;
                if (x < minCoord || x > maxCoord || z < minCoord || z > maxCoord) return false;
            }

            for (let i = 0; i < objects.length; i++) {
                let box = wallBox(objects[i]);
                if (x > box.min.x - 0.35 && x < box.max.x + 0.35 && z > box.min.z - 0.35 && z < box.max.z + 0.35) return false;
            }
            return true;
        }

        // --- Shared: teleport FOV-stretch feel ---
        // A short, sharp FOV spike on any successful teleport, eased back
        // down to normal over FOV_KICK_DURATION -- purely a visual "whoosh",
        // decoupled from any particular ability so future teleport-likes can
        // reuse it too.
        let fovKickTimeLeft = 0;
        const FOV_KICK_DURATION = 0.35;
        const FOV_KICK_PEAK = 140;
        const FOV_KICK_BASE = 75;
        function triggerFovKick() { fovKickTimeLeft = FOV_KICK_DURATION; }

        // --- Jumper Specific: Warp Blink [E] ---
        function startJumperBlinkAim() {
            if (player.jumperAimHeld || player.jumperBlinkCdLeft > 0) return;
            player.jumperAimHeld = true;
        }

        function confirmJumperBlinkAim() {
            if (!player.jumperAimHeld) return;
            player.jumperAimHeld = false;
            hideJumperAimMarker();

            if (player.jumperMarkerValid) {
                camera.position.x = player.jumperMarkerX;
                camera.position.z = player.jumperMarkerZ;
                player.jumperBlinkCdLeft = player.jumperBlinkCdMax;
                triggerFovKick();
                showFeedMessage("WARP BLINK!", "#00ff66");
            } else {
                showFeedMessage("WARP CANCELLED", "#ff2244");
            }
        }

        // --- Jumper Specific: Gravity Slam ultimate [F] ---
        function startJumperUltimateAim() {
            if (player.jumperUltAimHeld) return;
            player.jumperUltAimHeld = true;
        }

        function confirmJumperUltimateAim() {
            if (!player.jumperUltAimHeld) return;
            player.jumperUltAimHeld = false;
            hideJumperAimMarker();

            if (player.jumperUltMarkerValid) {
                player.ultCharge = 0; // charge is only spent now, on a confirmed valid cast
                updateUI();
                fireGravitySlamUltimate(player.jumperUltMarkerX, player.jumperUltMarkerZ);
                camera.position.x = player.jumperUltMarkerX;
                camera.position.z = player.jumperUltMarkerZ;
                triggerFovKick();
            } else {
                showFeedMessage("SLAM CANCELLED", "#ff2244");
            }
        }

        function spawnSlamVisual(x, z, radius, color) {
            const ringMat = new THREE.MeshBasicMaterial({ color: color || 0xaa33ff, transparent: true, opacity: 0.85, side: THREE.DoubleSide, depthTest: false });
            const ring = new THREE.Mesh(new THREE.RingGeometry(radius * 0.82, radius, 32), ringMat);
            ring.rotation.x = -Math.PI / 2;
            ring.position.set(x, 0.08, z);
            ring.renderOrder = 998;
            scene.add(ring);
            activeSlamEffects.push({ mesh: ring, mat: ringMat, elapsed: 0, duration: 0.45, baseScale: 0.6 });
        }

        // Ages the Gravity Slam shockwave rings by delta time (same
        // frame-driven pattern as updateSlashEffects, kept separate since
        // it's a plain expand+fade rather than a rotating sweep).
        function updateSlamEffects(delta) {
            for (let i = activeSlamEffects.length - 1; i >= 0; i--) {
                let fx = activeSlamEffects[i];
                fx.elapsed += delta;
                let t = Math.min(fx.elapsed / fx.duration, 1);
                fx.mesh.scale.setScalar(fx.baseScale + (1 - fx.baseScale) * t);
                fx.mat.opacity = 0.85 * (1 - t);
                if (t >= 1) {
                    scene.remove(fx.mesh);
                    fx.mesh.geometry.dispose(); fx.mat.dispose();
                    activeSlamEffects.splice(i, 1);
                }
            }
        }

        function fireGravitySlamUltimate(x, z) {
            let radius = WEAPONS[7].radius;
            let dmg = WEAPONS[7].damage * player.damageModifier;

            spawnSlamVisual(x, z, radius);

            if (bossBot && bossBot.body && Math.hypot(bossBot.body.position.x - x, bossBot.body.position.z - z) <= radius + 1.2) {
                bossBot.hp -= dmg;
                updateBossBar();
                if (bossBot && bossBot.hp > 0) applyStun(bossBot, JUMPER_SLAM_STUN_DURATION);
                checkBossDeath();
            }

            for (let eIdx = enemies.length - 1; eIdx >= 0; eIdx--) {
                let enemy = enemies[eIdx]; if (!enemy || !enemy.body) continue;
                if (Math.hypot(enemy.body.position.x - x, enemy.body.position.z - z) <= radius) {
                    enemy.hp -= dmg;
                    if (enemy.hp <= 0) {
                        killEnemy(eIdx);
                    } else {
                        applyStun(enemy, JUMPER_SLAM_STUN_DURATION); // survivors are stunned
                    }
                }
            }
            showFeedMessage("GRAVITY SLAM!", "#aa33ff");
        }

        // --- Jumper Specific: per-frame pieces ---
        // Warp Blink [E]: marker while held, cooldown otherwise.
        function updateWarpBlink(delta, skillElement) {
            if (player.jumperAimHeld) {
                let pt = computeJumperAimPoint(player.jumperBlinkRange);
                player.jumperMarkerX = pt.x; player.jumperMarkerZ = pt.z; player.jumperMarkerDist = pt.dist;
                player.jumperMarkerValid = isJumperDestinationValid(pt.x, pt.z);
                showJumperAimMarker(pt.x, pt.z, player.jumperMarkerValid);
                skillElement.innerText = player.jumperMarkerValid ? `WARP BLINK: READY TO JUMP` : `WARP BLINK: BLOCKED`;
            } else if (player.jumperBlinkCdLeft > 0) {
                player.jumperBlinkCdLeft -= delta;
                skillElement.innerText = `BLINK CD: ${player.jumperBlinkCdLeft.toFixed(1)}s`;
            } else {
                skillElement.innerText = `SKILL [E]: HOLD TO AIM WARP`;
            }
        }

        // Gravity Slam [F]: marker while held.
        function updateGravitySlamAim(delta) {
            const ultTextEl = document.getElementById('ult-text');
            if (player.jumperUltAimHeld) {
                let pt = computeJumperAimPoint(player.jumperBlinkRange);
                player.jumperUltMarkerX = pt.x; player.jumperUltMarkerZ = pt.z;
                player.jumperUltMarkerValid = isJumperDestinationValid(pt.x, pt.z);
                showJumperAimMarker(pt.x, pt.z, player.jumperUltMarkerValid);
                if (ultTextEl) ultTextEl.innerText = player.jumperUltMarkerValid ? "GRAVITY SLAM: HOLD TO TARGET" : "GRAVITY SLAM: BLOCKED";
            } else if (ultTextEl) {
                ultTextEl.innerText = "ULTIMATE [F]";
            }
        }

        // Teleport FOV whoosh + marker cleanup, shared by every loadout that
        // owns a Jumper ability.
        function updateJumperShared(delta) {
            if (fovKickTimeLeft > 0) {
                fovKickTimeLeft -= delta;
                let t = Math.max(0, fovKickTimeLeft / FOV_KICK_DURATION); // 1 -> 0
                camera.fov = FOV_KICK_BASE + (FOV_KICK_PEAK - FOV_KICK_BASE) * t;
            }
            if (!player.jumperAimHeld && !player.jumperUltAimHeld) hideJumperAimMarker();
        }

        function updateJumperSkill(delta, skillElement) {
            baseFrameDefaults();
            updateWarpBlink(delta, skillElement);
            updateGravitySlamAim(delta);
            updateJumperShared(delta);
            camera.updateProjectionMatrix();
        }

        // =====================================================================
        // --- Kira Specific: Death Note kills ---
        // Every enemy/boss carries a random "n" (regular enemies: 0-9, boss:
        // 100-999), shown as a floating number only while Kira is the active
        // role. Whichever enemy the crosshair is closest to becomes the
        // locked target; typing the digits of currentLevel * n on the number
        // keys kills it instantly, no weapon involved. A wrong/overlong entry
        // just clears the buffer -- there's no penalty, this is the troll role.
        // =====================================================================

        // =====================================================================
        // --- Kira Specific: Death Note kills ---
        // Every enemy's floating number IS the number that kills it (regular
        // enemies: a random 0-9 digit multiplied by the current stage, so
        // it's already the code, not a puzzle to compute; boss: a flat
        // random 100-999). Numbers only render while Kira is the active role.
        // There's no crosshair-lock -- typing a number that's within
        // KIRA_MATCH_TOLERANCE of ANY enemy's number kills the closest match,
        // so minions blocking line-of-sight on a boss can't stop you from
        // typing its number. A miss/overlong entry just clears the buffer --
        // no penalty, this is the troll role.
        // =====================================================================

        const KIRA_MATCH_TOLERANCE = 0; // exact match only -- type it right or no kill
        const KIRA_MAX_BUFFER_LEN = 3;

        function createKiraNumberSprite(number) {
            const canvas = document.createElement('canvas');
            canvas.width = 64; canvas.height = 64;
            const ctx = canvas.getContext('2d');
            ctx.font = 'bold 40px monospace';
            ctx.fillStyle = '#ff0000';
            ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
            ctx.fillText(String(number), 32, 34);
            const tex = new THREE.CanvasTexture(canvas);
            const mat = new THREE.SpriteMaterial({ map: tex, depthTest: false, transparent: true });
            const sprite = new THREE.Sprite(mat);
            sprite.scale.set(0.8, 0.8, 1);
            sprite.renderOrder = 996;
            return sprite;
        }

        function handleKiraDigitInput(digit) {
            player.kiraTypedBuffer += digit;
            let typedValue = parseInt(player.kiraTypedBuffer, 10);

            // Among every enemy whose number matches (within tolerance), the
            // physically nearest one dies -- ties on the number itself (two
            // enemies rolled the same digit) are broken by distance, not by
            // whichever happened to be checked first.
            let best = null, bestDist = Infinity;
            for (let i = 0; i < enemies.length; i++) {
                if (Math.abs(enemies[i].kiraNumber - typedValue) <= KIRA_MATCH_TOLERANCE) {
                    let d = camera.position.distanceTo(enemies[i].body.position);
                    if (d < bestDist) { bestDist = d; best = enemies[i]; }
                }
            }
            if (bossBot && Math.abs(bossBot.kiraNumber - typedValue) <= KIRA_MATCH_TOLERANCE) {
                let d = camera.position.distanceTo(bossBot.body.position);
                if (d < bestDist) { bestDist = d; best = bossBot; }
            }

            if (best) {
                killKiraTarget(best);
                player.kiraTypedBuffer = "";
            } else if (player.kiraTypedBuffer.length >= KIRA_MAX_BUFFER_LEN) {
                player.kiraTypedBuffer = "";
                showFeedMessage("WRONG NUMBER", "#ff2244");
            }
        }

        function killKiraTarget(target) {
            if (target === bossBot) {
                bossBot.hp = 0;
                updateBossBar();
                checkBossDeath();
                return;
            }
            let eIdx = enemies.indexOf(target);
            if (eIdx !== -1) killEnemy(eIdx);
        }

        // --- Kira Specific: time-slow ultimate ---
        // "He's so smart his mind runs faster than the world around him" --
        // everything except the player (enemies, their bullets, their attack
        // timers) runs in slow motion for KIRA_TIME_SLOW_DURATION seconds.
        // See the worldDelta/worldClock split in animate() for how this
        // actually gets applied without touching the player's own speed.
        function fireHyperCognitionUltimate() {
            kiraTimeSlowTimeLeft = kiraSlowDuration;
            showFeedMessage("HYPER COGNITION!", "#ff2244");
        }

        // --- Kira Specific: per-frame number-sprite tracking + HUD ---
        function updateKiraSkill(delta, skillElement) {
            player.speed = player.baseSpeed;
            camera.fov = 75; camera.updateProjectionMatrix();

            // Reposition every visible number sprite to float above its owner.
            for (let i = 0; i < enemies.length; i++) {
                let e = enemies[i];
                if (e.kiraSprite) e.kiraSprite.position.set(e.body.position.x, e.body.position.y + 1.0, e.body.position.z);
            }
            if (bossBot && bossBot.kiraSprite) {
                bossBot.kiraSprite.position.set(bossBot.body.position.x, bossBot.body.position.y + 2.8, bossBot.body.position.z);
            }

            skillElement.innerText = player.kiraTypedBuffer ? `DEATH NOTE: ${player.kiraTypedBuffer}` : `DEATH NOTE: type a number...`;
        }

        function triggerJump() {
            if (player.isGrounded) {
                player.yVelocity = player.jumpForce;
                player.isGrounded = false;
            }
        }

        function triggerUltimateAbility() {
            if (player.ultCharge < player.ultRequiredKills) return;

            const roleCfg = ROLES[selectedRole];
            if (!roleCfg) return;

            // Holdable ultimates (Jumper's Gravity Slam) start their aim on
            // press and only consume the charge on a valid release -- so a
            // cancelled cast costs nothing. Everything else fires instantly
            // on press, same as before.
            if (roleCfg.holdableUltimate) {
                if (roleCfg.onUltimateHoldStart) roleCfg.onUltimateHoldStart();
                return;
            }

            player.ultCharge = 0;
            updateUI();
            if (roleCfg.onUltimate) roleCfg.onUltimate();
        }

        // Fires on F release. No-ops for any role whose ultimate isn't
        // holdable (holdableUltimate unset) -- their ultimate already fired
        // instantly on press.
        function releaseUltimateHold() {
            const roleCfg = ROLES[selectedRole];
            if (roleCfg && roleCfg.holdableUltimate && roleCfg.onUltimateHoldRelease) {
                roleCfg.onUltimateHoldRelease();
            }
        }

        // --- Assassin Specific: Blade Wave ultimate ---
        // Pressing F only STARTS the cast: slow + zoom (see updateBladeWaveFx)
        // and the katana is raised overhead so it chops down while the
        // camera settles. launchBladeWave() runs when the cast ends.
        function fireBladeWaveUltimate() {
            player.ultCastEffectTimeLeft = ASSASSIN_ULT_FX_DURATION;
            if (currentWeaponId === 2 && weaponMesh) { // raise the katana; the idle lerp swings it back down = vertical chop
                weaponMesh.rotation.set(-2.3, -0.3, 0);
                weaponMesh.position.set(0.1, 0.2, -0.4);
            }
        }

        function launchBladeWave() {
            triggerVisualSlashEffect(true); // vertical top-to-bottom slash

            let startPos = camera.position.clone();
            let dir = new THREE.Vector3(0, 0, -1).applyQuaternion(camera.quaternion).normalize();

            let waveWidth = WEAPONS[5].width;
            let waveDmg = WEAPONS[5].damage;

            // Upright crescent facing the travel direction (a vertical blade
            // aura) instead of the old flat slab.
            const r = waveWidth / 2;
            const waveMesh = new THREE.Mesh(
                new THREE.RingGeometry(r * 0.86, r, 28, 1, 0, Math.PI),
                new THREE.MeshBasicMaterial({ color: 0x00ffaa, side: THREE.DoubleSide, transparent: true, opacity: 0.9 })
            );
            waveMesh.position.copy(startPos.clone().addScaledVector(dir, 1.0));
            waveMesh.position.y = 0.15;
            waveMesh.lookAt(waveMesh.position.clone().add(new THREE.Vector3(dir.x, 0, dir.z)));
            scene.add(waveMesh);

            waveProjectiles.push({
                mesh: waveMesh, dir: new THREE.Vector3(dir.x, 0, dir.z).normalize(), speed: WEAPONS[5].speed,
                damage: waveDmg, life: 3.0, hitEnemies: new Set(), radius: r + 0.25
            });
            showFeedMessage("BLADE WAVE LAUNCHED!", "#00ffaa");
        }

        // Alternates the slash swing direction (left-to-right / right-to-left)
        // so repeated slashes (e.g. a Phantom Dash kill-chain) don't all look
        // identical. Driven by the main animate() loop via activeSlashEffects
        // instead of setInterval, so rapid re-triggering (no-cooldown kill
        // chains, fast weapon fire rate) never stacks up multiple concurrent
        // timers -- each slash is one lightweight entry that ages out on its
        // own by delta time.
        let slashSwingSide = 1;
        function triggerVisualSlashEffect(vertical) {
            if (vertical) {
                // Overhead chop: a tall bright bar that drops from top to bottom of the view.
                const barMat = new THREE.MeshBasicMaterial({ color: 0x00ffaa, transparent: true, opacity: 0.95, depthTest: false });
                const bar = new THREE.Mesh(new THREE.BoxGeometry(0.1, 2.4, 0.01), barMat);
                bar.position.set(0, 1.3, -1.2);
                bar.renderOrder = 999;
                camera.add(bar);
                activeSlashEffects.push({ mesh: bar, mat: barMat, elapsed: 0, duration: 0.25, vertical: true, startY: 1.3, endY: -0.7 });
                return;
            }
            slashSwingSide *= -1;

            const slashGeo = new THREE.RingGeometry(0.65, 1.9, 20, 1, 0, Math.PI * 0.85);
            const slashMat = new THREE.MeshBasicMaterial({ color: 0x00ffaa, side: THREE.DoubleSide, transparent: true, opacity: 0.9, depthTest: false });
            const slashArc = new THREE.Mesh(slashGeo, slashMat);

            slashArc.position.set(0.15 * slashSwingSide, -0.1, -1.0);
            slashArc.renderOrder = 999;

            let startRot = 0.35 * slashSwingSide;
            let endRot = startRot - 1.3 * slashSwingSide;
            slashArc.rotation.set(0.25, 0, startRot);
            slashArc.scale.set(slashSwingSide, 1, 1); // mirror the arc for the reverse swing

            camera.add(slashArc);

            activeSlashEffects.push({
                mesh: slashArc, mat: slashMat, elapsed: 0, duration: 0.22,
                startRot: startRot, endRot: endRot
            });
        }

        // Advances every in-flight slash swing by delta time: sweeps the arc
        // from startRot to endRot with an ease-out, fades it, and pops the
        // scale slightly for impact -- then removes it once its duration is up.
        function updateSlashEffects(delta) {
            for (let i = activeSlashEffects.length - 1; i >= 0; i--) {
                let fx = activeSlashEffects[i];
                fx.elapsed += delta;
                let t = Math.min(fx.elapsed / fx.duration, 1);
                let ease = 1 - Math.pow(1 - t, 2);

                if (fx.vertical) fx.mesh.position.y = fx.startY + (fx.endY - fx.startY) * ease;
                else fx.mesh.rotation.z = fx.startRot + (fx.endRot - fx.startRot) * ease;
                fx.mat.opacity = 0.9 * (1 - t);

                if (t >= 1) {
                    camera.remove(fx.mesh);
                    fx.mesh.geometry.dispose(); fx.mat.dispose();
                    activeSlashEffects.splice(i, 1);
                }
            }
        }

        function reflectIncomingBullets() {
            if (!upgradeTiers.katanaReflect || upgradeTiers.katanaReflect <= 0) return;

            let reflectedCount = 0;
            let slashRange = 4.0;
            let camForward = new THREE.Vector3(0, 0, -1).applyQuaternion(camera.quaternion).normalize();

            for (let i = enemyBullets.length - 1; i >= 0; i--) {
                let eb = enemyBullets[i];
                let dist = camera.position.distanceTo(eb.mesh.position);
                if (dist <= slashRange) {
                    let toBullet = eb.mesh.position.clone().sub(camera.position).normalize();
                    if (camForward.dot(toBullet) > 0.1) {
                        eb.mesh.material.color.setHex(0x00ffaa);
                        
                        let returnDir = camForward.clone().add(new THREE.Vector3((Math.random()-0.5)*0.1, (Math.random()-0.5)*0.1, (Math.random()-0.5)*0.1)).normalize();
                        
                        pushPlayerBullet({
                            mesh: eb.mesh,
                            dir: returnDir,
                            speed: eb.speed * 2.2,
                            damage: 120 * player.damageModifier,
                            isRocket: false,
                            life: 2.5
                        });

                        enemyBullets.splice(i, 1);
                        reflectedCount++;
                    }
                }
            }
            if (reflectedCount > 0) {
                showFeedMessage(`DEFLECTED ${reflectedCount} BULLET(S)!`, "#00ffaa");
            }
        }

        function applyPlayerDamage(amount) {
            player.health -= amount;
            showFeedMessage(`-[${amount} HP] DAMAGE TAKEN!`, "#ff3333");
            updateUI();
        }

        // Role/loadout kill hook (Shotgunner dash refresh, Phantom Rush refresh).
        function runKillHook() {
            const rc = ROLES[selectedRole];
            if (rc && rc.onKill) rc.onKill();
        }

        function handleEnemyDefeatedReward(destroyedPosition = null, isMinion = false) {
            let pts = isMinion ? 50 : 150;
            player.score += pts; 
            player.timeLeft += isMinion ? 1.0 : 2.0; 

            showFeedMessage(`TARGET ELIMINATED (+${pts} SCORE)`, "#ffff00");

            onKillBuffs.killCount++;
            onKillBuffs.timer = 5.0;

            if (upgradeTiers.nanoSiphon > 0) { // heals on every kill regardless of role now
                let healFactor = getTierBonus(upgradeTiers.nanoSiphon, 4);
                let oldHp = player.health;
                player.health = Math.min(player.health + healFactor, player.maxHealth);
                if (player.health > oldHp) {
                    showFeedMessage(`+${player.health - oldHp} HP SIPHONED`, "#00ffaa");
                }
            }

            if (player.ultCharge < player.ultRequiredKills) player.ultCharge++;

            WEAPONS[3].reserve = Math.min(WEAPONS[3].reserve + 4, WEAPONS[3].maxReserve);
            if (destroyedPosition && gameMode !== 'TD' && Math.random() < 0.35) spawnHealthPickup(destroyedPosition.x, destroyedPosition.z);

            runKillHook();
            
            if (isMinion && isBossStage) {
                let respawnPos = getRandomArenaPerimeter();
                spawnEnemyBot(respawnPos.x, respawnPos.z, true);
            }
            updateUI();
        }

        function spawnHealthPickup(x, z) {
            const pack = new THREE.Mesh(new THREE.BoxGeometry(0.3, 0.3, 0.3), new THREE.MeshBasicMaterial({ color: 0x00ff55 }));
            pack.position.set(x, 0.5, z);
            scene.add(pack); healthPickups.push(pack);
        }

        function spawnLocator(x, z) {
            const locatorMesh = new THREE.Mesh(new THREE.TorusGeometry(0.25, 0.08, 8, 16), new THREE.MeshBasicMaterial({ color: 0xffff00 }));
            locatorMesh.rotation.x = Math.PI / 2; locatorMesh.position.set(x, 1.0, z);
            scene.add(locatorMesh); locators.push(locatorMesh);
        }

        function getRandomEmptyCell() {
            if (isBossStage) return getRandomArenaPerimeter();
            let validCells = [];
            for (let r = 1; r < mazeSize - 1; r++) {
                for (let c = 1; c < mazeSize - 1; c++) {
                    if (rawGrid[r][c] === 0) validCells.push({ r, c });
                }
            }
            if (validCells.length === 0) return { x: 0, z: 0 };
            let choice = validCells[Math.floor(Math.random() * validCells.length)];
            return { x: (choice.c * cellSize) - mazeOffset, z: (choice.r * cellSize) - mazeOffset };
        }

        function getRandomArenaPerimeter() {
            let angle = Math.random() * Math.PI * 2;
            let radius = 12 + Math.random() * 8;
            return { x: Math.cos(angle) * radius, z: Math.sin(angle) * radius };
        }

        function fireRpgUltimateAnimation() {
            savedWeaponBeforeUlt = currentWeaponId; 
            currentWeaponId = 4;
            buildWeaponMesh();
            
            let startPos = camera.position.clone();
            let baseDir = new THREE.Vector3(0, 0, -1).applyQuaternion(camera.quaternion).normalize();

            let knockbackVector = baseDir.clone().negate().setY(0).normalize();
            player.dashMomentum.addScaledVector(knockbackVector, 28.0); 

            const rocketMesh = new THREE.Mesh(new THREE.CylinderGeometry(0.18, 0.18, 0.7, 8), new THREE.MeshBasicMaterial({ color: 0xff3300 }));
            rocketMesh.geometry.rotateX(Math.PI / 2);
            rocketMesh.position.copy(startPos.clone().addScaledVector(baseDir, 0.6));
            rocketMesh.lookAt(startPos.clone().addScaledVector(baseDir, 10));
            scene.add(rocketMesh);
            
            pushPlayerBullet({
                mesh: rocketMesh, dir: baseDir, speed: WEAPONS[4].projectileSpeed,
                damage: WEAPONS[4].damage, isRocket: true, splashRadius: WEAPONS[4].splashRadius, life: 5.0
            });

            weaponMesh.position.y = -0.6;
            setTimeout(() => {
                currentWeaponId = savedWeaponBeforeUlt;
                buildWeaponMesh();
                updateUI();
            }, 400);
        }

        // Mobile aim assist: thumb aiming is imprecise, so when an enemy is
        // already close to the crosshair the shot is pulled most of the way
        // onto it (chest height). Wide enough to feel helpful, narrow enough
        // that it never snaps to something you weren't aiming near.
        function applyAimAssist(dir) {
            let best = null, bestDot = 0.975; // ~13 degrees
            const consider = (t) => {
                const to = t.body.position.clone().sub(camera.position);
                const dist = to.length();
                if (dist > 38 || dist < 0.5) return;
                to.normalize();
                const d = dir.dot(to);
                if (d > bestDot) { bestDot = d; best = t; }
            };
            for (let i = 0; i < enemies.length; i++) consider(enemies[i]);
            if (bossBot && bossBot.body) consider(bossBot);
            if (!best) return dir;
            const aim = best.body.position.clone(); aim.y += 0.35;
            const toAim = aim.sub(camera.position).normalize();
            return dir.clone().lerp(toAim, 0.75).normalize();
        }

        function shoot() {
            const now = clock.getElapsedTime();
            const w = WEAPONS[currentWeaponId];

            let activeFireRate = w.fireRate * player.fireRateModifier;
            if (now - w.lastFired < activeFireRate) return;

            // --- Kira Specific: Death Note has no gun -- M1 does nothing ---
            if (currentWeaponId === 8) return;

            if (currentWeaponId === 2) { 
                // --- Assassin Specific: manual Katana slash (left click) ---
                // Works normally whether or not Phantom Rush is active --
                // Phantom Rush no longer auto-slashes on its own, so this is
                // now the only source of damage during the hyper-speed
                // window too, and a kill while it's active refreshes the
                // window back to a fresh PHANTOM_WINDOW_DURATION.
                w.lastFired = now;
                weaponMesh.rotation.set(-0.5, 1.3, -0.7);
                weaponMesh.position.set(-0.1, -0.15, -0.35);

                triggerVisualSlashEffect();
                reflectIncomingBullets(); 

                let slashDir = new THREE.Vector3(0, 0, -1).applyQuaternion(camera.quaternion).normalize();
                let rushOn = player.phantomActive;
                let swingRange = w.range + (rushOn ? getTierBonus(upgradeTiers.phantomRange, 0.8) : 0);
                let baseKatanaDmg = (w.damage + (rushOn ? getTierBonus(upgradeTiers.phantomDamage, 60) : 0)) * player.damageModifier;
                let killedThisSwing = false;

                for (let eIdx = enemies.length - 1; eIdx >= 0; eIdx--) {
                    let enemy = enemies[eIdx]; if (!enemy || !enemy.body) continue;
                    let dist = camera.position.distanceTo(enemy.body.position);
                    if (dist <= swingRange) {
                        let toEnemy = enemy.body.position.clone().sub(camera.position).normalize();
                        if (slashDir.dot(toEnemy) > 0.3) {
                            enemy.hp -= baseKatanaDmg;
                            if (enemy.hp <= 0) {
                                killEnemy(eIdx);
                                killedThisSwing = true;
                            }
                        }
                    }
                }

                if (bossBot && bossBot.body && camera.position.distanceTo(bossBot.body.position) <= swingRange + 1.5) {
                    bossBot.hp -= baseKatanaDmg;
                    updateBossBar();
                    if (bossBot.hp <= 0) killedThisSwing = true;
                    checkBossDeath();
                }

                return;
            }

            if (w.reserve <= 0) return;
            if (w.reserve !== Infinity) w.reserve--;

            w.lastFired = now;
            weaponMesh.position.z += 0.15;
            weaponMesh.rotation.x -= (w.recoil ? w.recoil.pitch * 1.6 : 0);
            applyRecoilKick(w.recoil);

            let startPos = camera.position.clone();
            let baseDir = new THREE.Vector3(0, 0, -1).applyQuaternion(camera.quaternion).normalize();
            if (IS_MOBILE) baseDir = applyAimAssist(baseDir);
            let calculatedDmg = w.damage * player.damageModifier;

            if (w.name === "CYBER SHOTGUN") {
                let activeSpread = player.isGrounded ? w.spread : w.spread * 1.35;
                for (let i = 0; i < w.pelletCount; i++) {
                    const bulletMesh = new THREE.Mesh(new THREE.SphereGeometry(0.06, 4, 4), new THREE.MeshBasicMaterial({ color: w.color }));
                    let spreadDir = baseDir.clone().add(new THREE.Vector3((Math.random() - 0.5) * activeSpread, (Math.random() - 0.5) * activeSpread, (Math.random() - 0.5) * activeSpread)).normalize();
                    bulletMesh.position.copy(startPos.clone().addScaledVector(spreadDir, 0.2));
                    scene.add(bulletMesh);
                    pushPlayerBullet({ mesh: bulletMesh, dir: spreadDir, speed: w.projectileSpeed, damage: calculatedDmg, isRocket: false, life: 1.0 });
                }
            } else {
                const bulletMesh = new THREE.Mesh(new THREE.SphereGeometry(0.08, 4, 4), new THREE.MeshBasicMaterial({ color: w.color }));
                bulletMesh.position.copy(startPos.clone().addScaledVector(baseDir, 0.2));
                scene.add(bulletMesh);
                pushPlayerBullet({ mesh: bulletMesh, dir: baseDir, speed: w.projectileSpeed, damage: calculatedDmg, isRocket: false, life: 2.0 });
            }
            updateUI();
        }

        function triggerRocketExplosion(blastPoint, radius, damage) {
            const expMesh = new THREE.Mesh(new THREE.SphereGeometry(radius, 8, 8), new THREE.MeshBasicMaterial({ color: 0xffaa00, transparent: true, opacity: 0.6 }));
            expMesh.position.copy(blastPoint);
            scene.add(expMesh);
            setTimeout(() => { scene.remove(expMesh); }, 200);

            let calculatedDamage = damage * player.damageModifier;

            if (bossBot && bossBot.body) {
                let distance = bossBot.body.position.distanceTo(blastPoint);
                if (distance <= radius + 1.5) {
                    bossBot.hp -= Math.floor(calculatedDamage * 1.2);
                    updateBossBar(); checkBossDeath();
                }
            }

            for (let eIdx = enemies.length - 1; eIdx >= 0; eIdx--) {
                let enemy = enemies[eIdx]; if (!enemy || !enemy.body) continue;
                let distance = enemy.body.position.distanceTo(blastPoint);
                if (distance <= radius) {
                    let falloffFactor = 1.0 - (distance / radius);
                    let finalDamage = Math.floor(calculatedDamage * falloffFactor);
                    if (finalDamage < 30) finalDamage = 30;
                    enemy.hp -= finalDamage;

                    if (enemy.hp <= 0) {
                        killEnemy(eIdx);
                    }
                }
            }
            updateUI();
        }

        // =====================================================================
        // --- Shared: enemy death cleanup + particle burst ---
        // Every "an enemy died" code path (bullets, melee, dashes, AoE
        // abilities) now goes through this one function instead of each
        // repeating the same remove/splice/reward lines, so a future kill
        // source can't forget a cleanup step and effects like the particle
        // burst only need to be wired up once.
        // =====================================================================

        // =====================================================================
        // --- Shared: bullet-impact sparks (pooled -- deliberately cheap) ---
        // A fixed-size pool of plain, textureless sprites created once and
        // recycled round-robin, instead of creating+disposing geometry per
        // hit. Shotgun pellets (and anything with bullet-bounce-style high
        // hit rates) can trigger many of these a second, so no per-hit
        // allocation at all is the point -- just flipping a few properties
        // on an already-existing object.
        // =====================================================================
        const HIT_SPARK_POOL_SIZE = 20;
        let hitSparkPool = [];
        let hitSparkNext = 0;

        function ensureHitSparkPool() {
            if (hitSparkPool.length) return;
            for (let i = 0; i < HIT_SPARK_POOL_SIZE; i++) {
                const mat = new THREE.SpriteMaterial({ color: 0xffffff, transparent: true, opacity: 0, depthTest: false });
                const spr = new THREE.Sprite(mat);
                spr.scale.set(0.001, 0.001, 1);
                spr.visible = false;
                spr.renderOrder = 995;
                scene.add(spr);
                hitSparkPool.push({ mesh: spr, mat: mat, life: 0 });
            }
        }

        function spawnHitSpark(position, color) {
            ensureHitSparkPool();
            let s = hitSparkPool[hitSparkNext];
            hitSparkNext = (hitSparkNext + 1) % HIT_SPARK_POOL_SIZE;
            s.mesh.position.copy(position);
            s.mesh.visible = true;
            s.mesh.scale.set(0.22, 0.22, 1);
            s.mat.color.setHex(color);
            s.mat.opacity = 0.95;
            s.life = 0.1;
        }

        function updateHitSparks(delta) {
            for (let i = 0; i < hitSparkPool.length; i++) {
                let s = hitSparkPool[i];
                if (s.life <= 0) continue;
                s.life -= delta;
                if (s.life <= 0) { s.mesh.visible = false; continue; }
                let t = s.life / 0.1;
                s.mat.opacity = 0.95 * t;
            }
        }

        let activeDeathParticles = [];

        // Generic yellow particle burst -- used for enemy deaths (big/small)
        // and the smaller, shorter stun sparks.
        function spawnParticleBurst(position, particleCount, speedScale, size, duration) {
            const positions = new Float32Array(particleCount * 3);
            const velocities = [];
            for (let i = 0; i < particleCount; i++) {
                positions[i * 3] = position.x;
                positions[i * 3 + 1] = position.y;
                positions[i * 3 + 2] = position.z;
                let dir = new THREE.Vector3((Math.random() - 0.5), Math.random() * 0.8 + 0.2, (Math.random() - 0.5)).normalize();
                velocities.push(dir.multiplyScalar(speedScale * (0.5 + Math.random())));
            }
            const geo = new THREE.BufferGeometry();
            geo.setAttribute('position', new THREE.BufferAttribute(positions, 3));
            const mat = new THREE.PointsMaterial({ color: 0xffdd00, size: size, transparent: true, opacity: 1.0, depthTest: false });
            const points = new THREE.Points(geo, mat);
            points.renderOrder = 997;
            scene.add(points);
            activeDeathParticles.push({ points: points, mat: mat, velocities: velocities, elapsed: 0, duration: duration });
        }

        function spawnDeathBurst(position, isBig) {
            spawnParticleBurst(position, isBig ? 60 : 18, isBig ? 6.0 : 4.0, isBig ? 0.35 : 0.2, isBig ? 0.9 : 0.6);
        }

        // --- Jumper Specific: stun ---
        // A stunned enemy/boss can't shoot until stunTimeLeft runs out, and
        // throws off small yellow sparks so the player can see it's disabled.
        function applyStun(target, duration) {
            target.stunTimeLeft = duration;
            target.stunSparkTimer = 0;
        }

        function updateStun(delta) {
            const tick = (t, sparkY) => {
                if (!(t.stunTimeLeft > 0)) return;
                t.stunTimeLeft -= delta;
                t.stunSparkTimer -= delta;
                if (t.stunSparkTimer <= 0) {
                    t.stunSparkTimer = 0.12;
                    spawnParticleBurst(new THREE.Vector3(t.body.position.x, t.body.position.y + sparkY, t.body.position.z), 4, 2.5, 0.16, 0.3);
                }
            };
            for (let i = 0; i < enemies.length; i++) tick(enemies[i], 0.9);
            if (bossBot && bossBot.body) tick(bossBot, 2.6);
        }

        function updateDeathParticles(delta) {
            for (let i = activeDeathParticles.length - 1; i >= 0; i--) {
                let fx = activeDeathParticles[i];
                fx.elapsed += delta;
                let t = Math.min(fx.elapsed / fx.duration, 1);

                let posAttr = fx.points.geometry.attributes.position;
                for (let p = 0; p < fx.velocities.length; p++) {
                    posAttr.array[p * 3] += fx.velocities[p].x * delta;
                    posAttr.array[p * 3 + 1] += (fx.velocities[p].y - 5.0 * fx.elapsed) * delta; // gentle gravity
                    posAttr.array[p * 3 + 2] += fx.velocities[p].z * delta;
                }
                posAttr.needsUpdate = true;
                fx.mat.opacity = 1.0 * (1 - t);

                if (t >= 1) {
                    scene.remove(fx.points);
                    fx.points.geometry.dispose(); fx.mat.dispose();
                    activeDeathParticles.splice(i, 1);
                }
            }
        }

        // Removes a regular enemy at `eIdx`, spawns its death burst, and
        // grants the kill reward. Use this instead of hand-rolling the
        // remove/splice/reward sequence at a new kill site.
        function killEnemy(eIdx) {
            let enemy = enemies[eIdx];
            if (!enemy) return;
            let deadPos = enemy.body.position.clone();
            spawnDeathBurst(deadPos, false);
            scene.remove(enemy.body); scene.remove(enemy.head); scene.remove(enemy.gun);
            if (enemy.kiraSprite) scene.remove(enemy.kiraSprite);
            enemies.splice(eIdx, 1);
            if (enemy.bonusPts) player.score += enemy.bonusPts;
            handleEnemyDefeatedReward(deadPos, enemy.isMinion);
        }

        // =====================================================================
        // --- Mirror boss ---
        // Every MIRROR_BOSS_INTERVAL-th stage the boss copies the player's
        // skill (a movement move) and ultimate (a big attack):
        //   Shotgunner: DASH + RPG   Assassin: CHARGE + WAVE   Jumper: BLINK + SLAM
        // Blank Slate maps whatever skill/ultimate you bought. Each move is
        // telegraphed (red markers + the boss glowing) for ~0.8s, then happens
        // once; the boss alternates skill / ultimate every MIRROR_MOVE_COOLDOWN
        // seconds. All timers run on world time, so Hyper Cognition slows it.
        // =====================================================================
        const MIRROR_BOSS_INTERVAL = 6;
        const MIRROR_MOVE_COOLDOWN = 6.5;
        const MIRROR_TELEGRAPH = 0.8;

        function pickMirrorSet() {
            let skill = null, ult = null;
            if (gameMode === 'CLASSIC') {
                const sets = { SHOTGUNNER: ['DASH', 'RPG'], ASSASSIN: ['CHARGE', 'WAVE'], JUMPER: ['BLINK', 'SLAM'] };
                const s = sets[selectedRole];
                if (s) { skill = s[0]; ult = s[1]; }
            } else if (gameMode === 'SHOP') {
                skill = ({ KINETIC_DASH: 'DASH', PHANTOM_RUSH: 'CHARGE', WARP_BLINK: 'BLINK' })[shopLoadout.skill] || null;
                ult = ({ RPG_BARRAGE: 'RPG', BLADE_WAVE: 'WAVE', GRAVITY_SLAM: 'SLAM' })[shopLoadout.ult] || null;
            }
            return (skill || ult) ? { skill: skill, ult: ult } : null;
        }

        function clearMirrorFx() {
            if (!bossBot || !bossBot.mirror) return;
            bossBot.mirror.fx.forEach(m => scene.remove(m));
            bossBot.mirror.fx = [];
            const d = bossBot.mirror.data;
            if (d.rocketMesh) { scene.remove(d.rocketMesh); d.rocketMesh = null; }
            d.rocketAlive = false;
        }

        function setBossPos(x, z) {
            const r = Math.hypot(x, z);
            if (r > 22.5) { x *= 22.5 / r; z *= 22.5 / r; }
            bossBot.body.position.x = x; bossBot.body.position.z = z;
            bossBot.head.position.x = x; bossBot.head.position.z = z;
        }

        function mirrorStrip(dirX, dirZ, len, width) {
            const m = new THREE.Mesh(new THREE.BoxGeometry(width, 0.05, len), new THREE.MeshBasicMaterial({ color: 0xff2244, transparent: true, opacity: 0.45, depthWrite: false }));
            m.position.set(bossBot.body.position.x + dirX * len / 2, 0.1, bossBot.body.position.z + dirZ * len / 2);
            m.rotation.y = Math.atan2(dirX, dirZ);
            scene.add(m); bossBot.mirror.fx.push(m);
        }

        function mirrorPillar(x, z) {
            const m = new THREE.Mesh(new THREE.CylinderGeometry(0.3, 0.3, 14, 8), new THREE.MeshBasicMaterial({ color: 0xff2244, transparent: true, opacity: 0.5, depthWrite: false }));
            m.position.set(x, 7, z);
            scene.add(m); bossBot.mirror.fx.push(m);
        }

        function mirrorDisc(x, z, r) {
            const m = new THREE.Mesh(new THREE.CircleGeometry(r, 32), new THREE.MeshBasicMaterial({ color: 0xff2244, transparent: true, opacity: 0.35, side: THREE.DoubleSide, depthWrite: false }));
            m.rotation.x = -Math.PI / 2; m.position.set(x, 0.1, z);
            scene.add(m); bossBot.mirror.fx.push(m);
        }

        function updateBossMirror(wd) {
            const m = bossBot.mirror;
            if (bossBot.stunTimeLeft > 0) return; // stunned: the whole routine pauses
            if (m.state === 'IDLE') {
                m.timer -= wd;
                if (m.timer <= 0) startMirrorMove();
            } else if (m.state === 'TELEGRAPH') {
                m.timer -= wd;
                bossBot.body.material.emissive.setHex(Math.floor(worldClock * 12) % 2 ? 0xff2200 : 0x550000); // flash
                if (m.timer <= 0) executeMirrorMove();
            } else {
                m.timer -= wd;
                tickMirrorAction(wd);
                if (m.timer <= 0) endMirrorMove();
            }
        }

        function startMirrorMove() {
            const m = bossBot.mirror, d = m.data;
            let which = m.useUlt ? m.ult : m.skill;
            if (!which) which = m.useUlt ? m.skill : m.ult; // only one of the two is copyable
            m.which = which; m.state = 'TELEGRAPH'; m.timer = (which === 'SLAM') ? 1.0 : (which === 'RPG' ? 1.2 : MIRROR_TELEGRAPH);

            const bx = bossBot.body.position.x, bz = bossBot.body.position.z;
            let dx = camera.position.x - bx, dz = camera.position.z - bz;
            const dl = Math.hypot(dx, dz) || 1; dx /= dl; dz /= dl;
            d.dirX = dx; d.dirZ = dz;

            const names = { DASH: 'MIRROR DASH!', CHARGE: 'MIRROR CHARGE!', BLINK: 'MIRROR BLINK!', RPG: 'MIRROR RPG!', WAVE: 'MIRROR WAVE!', SLAM: 'MIRROR SLAM!' };
            showFeedMessage(names[which], '#ff2244');

            if (which === 'DASH') mirrorStrip(dx, dz, 18, 2.4);
            else if (which === 'WAVE') mirrorStrip(dx, dz, 26, 3.2);
            else if (which === 'BLINK') {
                // lands on the far side of the player, so it ends up behind them
                d.destX = camera.position.x + dx * 5; d.destZ = camera.position.z + dz * 5;
                const r = Math.hypot(d.destX, d.destZ); if (r > 22.5) { d.destX *= 22.5 / r; d.destZ *= 22.5 / r; }
                mirrorDisc(d.destX, d.destZ, 1.8);
            } else if (which === 'RPG') {
                // Obvious red mark: laser line from the boss, a big red disc where the
                // rocket will land and a tall pillar so it can be seen from anywhere.
                d.rpgX = camera.position.x; d.rpgZ = camera.position.z;
                const rx = d.rpgX - bx, rz = d.rpgZ - bz, rl = Math.hypot(rx, rz) || 1;
                mirrorStrip(rx / rl, rz / rl, rl, 0.8);   // fx[0]: laser line (removed at launch)
                mirrorDisc(d.rpgX, d.rpgZ, 4.5);          // fx[1]
                mirrorPillar(d.rpgX, d.rpgZ);             // fx[2]
            } else if (which === 'SLAM') {
                d.slamX = camera.position.x; d.slamZ = camera.position.z;
                mirrorDisc(d.slamX, d.slamZ, 6);
            }
        }

        function executeMirrorMove() {
            const m = bossBot.mirror, d = m.data;
            if (m.which === 'RPG') { const strip = m.fx.shift(); if (strip) scene.remove(strip); } // keep the red mark until impact
            else clearMirrorFx();
            m.state = 'ACTION'; d.hit = false; d.hitCd = 0;

            if (m.which === 'DASH') { m.timer = 0.35; }
            else if (m.which === 'CHARGE') { m.timer = 1.8; }
            else if (m.which === 'BLINK') {
                spawnParticleBurst(bossBot.body.position.clone(), 24, 6, 0.3, 0.5);
                setBossPos(d.destX, d.destZ);
                spawnParticleBurst(bossBot.body.position.clone(), 24, 6, 0.3, 0.5);
                m.timer = 0.3;
            } else if (m.which === 'RPG') {
                const sx = bossBot.head.position.x, sz = bossBot.head.position.z;
                const mesh = new THREE.Mesh(new THREE.SphereGeometry(0.45, 8, 8), new THREE.MeshBasicMaterial({ color: 0xff3300 }));
                mesh.position.set(sx, 4.2, sz);
                scene.add(mesh);
                d.rocketMesh = mesh; d.rocketStartX = sx; d.rocketStartZ = sz; d.rocketAlive = true;
                m.timer = 6; // safety cap; the explosion ends the move much earlier
            } else if (m.which === 'WAVE') {
                const r = 2.2;
                const mesh = new THREE.Mesh(new THREE.RingGeometry(r * 0.86, r, 24, 1, 0, Math.PI), new THREE.MeshBasicMaterial({ color: 0xff2244, side: THREE.DoubleSide, transparent: true, opacity: 0.9 }));
                mesh.position.set(bossBot.body.position.x + d.dirX * 2.5, 0.15, bossBot.body.position.z + d.dirZ * 2.5);
                mesh.lookAt(new THREE.Vector3(mesh.position.x + d.dirX, 0.15, mesh.position.z + d.dirZ));
                scene.add(mesh);
                pushEnemyBullet({ mesh: mesh, dir: new THREE.Vector3(d.dirX, 0, d.dirZ), speed: 22, damage: Math.round(bossBot.damage * 0.8), life: 2.5, radius: 2.4, flat: true });
                m.timer = 0.3;
            } else if (m.which === 'SLAM') {
                spawnSlamVisual(d.slamX, d.slamZ, 6);
                if (Math.hypot(camera.position.x - d.slamX, camera.position.z - d.slamZ) <= 6) {
                    applyPlayerDamage(Math.round(bossBot.damage * 0.9));
                    player.slowTimeLeft = 1.5;
                }
                m.timer = 0.4;
            }
        }

        function tickMirrorAction(wd) {
            const m = bossBot.mirror, d = m.data;
            const px = camera.position.x, pz = camera.position.z;
            if (m.which === 'DASH') {
                setBossPos(bossBot.body.position.x + d.dirX * 40 * wd, bossBot.body.position.z + d.dirZ * 40 * wd);
                if (!d.hit && Math.hypot(bossBot.body.position.x - px, bossBot.body.position.z - pz) <= 2.8) {
                    d.hit = true; applyPlayerDamage(Math.round(bossBot.damage * 0.7));
                }
            } else if (m.which === 'RPG' && d.rocketAlive) {
                const rm = d.rocketMesh;
                const dx = d.rpgX - rm.position.x, dz = d.rpgZ - rm.position.z, dl = Math.hypot(dx, dz), step = 28 * wd;
                if (dl <= step) {
                    // impact: blast radius matches the red disc, so standing outside it is safe
                    scene.remove(rm); d.rocketMesh = null; d.rocketAlive = false;
                    clearMirrorFx();
                    spawnSlamVisual(d.rpgX, d.rpgZ, 4.5, 0xff3300);
                    spawnParticleBurst(new THREE.Vector3(d.rpgX, 0.6, d.rpgZ), 40, 8, 0.4, 0.7);
                    if (Math.hypot(px - d.rpgX, pz - d.rpgZ) <= 4.5) applyPlayerDamage(Math.round(bossBot.damage * 0.9));
                    m.timer = 0.4;
                } else {
                    const total = Math.hypot(d.rpgX - d.rocketStartX, d.rpgZ - d.rocketStartZ) || 1;
                    rm.position.x += dx / dl * step; rm.position.z += dz / dl * step;
                    rm.position.y = 0.4 + 3.8 * Math.min(1, dl / total); // descends as it travels
                    spawnHitSpark(rm.position, 0xff6600); // cheap pooled trail
                }
            } else if (m.which === 'CHARGE') {
                let dx = px - bossBot.body.position.x, dz = pz - bossBot.body.position.z; const dl = Math.hypot(dx, dz) || 1;
                if (dl > 2.4) setBossPos(bossBot.body.position.x + dx / dl * 13 * wd, bossBot.body.position.z + dz / dl * 13 * wd);
                d.hitCd -= wd;
                if (dl <= 3.0 && d.hitCd <= 0) { d.hitCd = 0.7; applyPlayerDamage(Math.round(bossBot.damage * 0.4)); }
            }
        }

        function endMirrorMove() {
            const m = bossBot.mirror;
            bossBot.body.material.emissive.setHex(0x330033);
            clearMirrorFx();
            m.state = 'IDLE'; m.timer = MIRROR_MOVE_COOLDOWN; m.useUlt = !m.useUlt;
        }

        function checkBossDeath() {
            if (bossBot && bossBot.hp <= 0) {
                spawnDeathBurst(bossBot.body.position.clone(), true);
                player.score += 2000; player.timeLeft += 20; 
                runKillHook();
                showFeedMessage("BOSS DESTROYED! PORTAL OPENED", "#ff00ff");
                scene.remove(bossBot.body); scene.remove(bossBot.head);
                if (bossBot.kiraSprite) scene.remove(bossBot.kiraSprite);
                clearMirrorFx();
                bossBot = null;
                document.getElementById('boss-ui').style.display = 'none';

                goalMesh.position.set(0, 1.8, 0);
                if (waypointBeaconMesh) waypointBeaconMesh.position.set(0, 75, 0);
            }
        }

        function updateBossBar() {
            if (!bossBot) return;
            let percentage = Math.max(0, (bossBot.hp / bossBot.maxHp) * 100);
            document.getElementById('boss-bar').style.width = percentage + "%";
        }

        function enemyShoot(enemy, isBoss = false) {
            const bulletMesh = new THREE.Mesh(new THREE.SphereGeometry(isBoss ? 0.35 : 0.15, 6, 6), new THREE.MeshBasicMaterial({ color: isBoss ? 0xff00ff : 0xff3333 }));
            let startPos = enemy.head.position.clone();
            let shootDir = new THREE.Vector3().subVectors(camera.position, startPos).normalize();
            bulletMesh.position.copy(startPos);
            scene.add(bulletMesh);
            pushEnemyBullet({ mesh: bulletMesh, dir: shootDir, speed: isBoss ? 16.0 : 14.5, damage: enemy.damage, life: 4.0 });
        }

        // =====================================================================
        // --- Shop (Blank Slate + Crystal Defense) ---
        // Click an item, then BUY / UPGRADE / SELL. Skills and ultimates are
        // one-of-each (owning one dims the rest); upgrades are repeatable.
        // Points are player.score. SELL refunds half of everything invested.
        // =====================================================================
        let shopSelected = null, shopMessage = '';

        function passiveEntry(id) { return UPGRADE_REGISTRY.find(u => u.id === id); }
        function passiveCost(p) { return p.baseCost * ((upgradeTiers[p.id] || 0) + 1); }
        function applyPassive(id) {
            const u = passiveEntry(id);
            u.apply(upgradeTiers[id] || 0, u.getBase);
            if (player.health > player.maxHealth) player.health = player.maxHealth;
        }

        // Drops any in-progress aim/rush state when a skill is sold.
        function clearLoadoutStates() {
            player.phantomActive = false; player.jumperAimHeld = false; player.jumperUltAimHeld = false;
            hideJumperAimMarker();
        }

        function openShop(context) {
            shopContext = context;
            gameState = "SHOP";
            document.exitPointerLock();
            let title = context === 'WAVE' ? `WAVE ${td.wave} CLEARED` : (context === 'PREP' ? 'PREPARE YOUR DEFENSES' : `STAGE ${currentLevel} CLEARED`);
            if (weaponShopOpen()) title += ' - WEAPON SHOP OPEN';
            document.getElementById('shop-title').innerText = title;
            shopSelected = null; shopMessage = ''; tdPad = null;
            renderShop();
            document.getElementById('shop-screen').style.display = 'flex';
        }

        function closeShop() {
            document.getElementById('shop-screen').style.display = 'none';
            document.getElementById('loading-screen').style.display = 'flex';
            clearLoadoutStates();
            setTimeout(() => {
                if (gameMode === 'TD') startTDWave();
                else advanceLevelCore();
                document.getElementById('loading-screen').style.display = 'none';
                gameState = "PLAYING";
                document.body.requestPointerLock();
                updateUI();
            }, 100);
        }

        function shopSay(msg) { shopMessage = msg; renderShopDetail(); }

        function renderShop() {
            document.getElementById('shop-points').innerText = 'POINTS: ' + player.score;
            const isTD = (gameMode === 'TD');
            document.getElementById('shop-weapon-col').style.display = isTD ? 'none' : 'block';
            document.getElementById('shop-col1-title').innerText = isTD ? 'BUILD PADS - PICK ONE' : 'SKILL [E] - PICK ONE';
            document.getElementById('shop-col2-title').innerText = isTD ? 'TURRETS - THE ROLES' : 'ULTIMATE [F] - PICK ONE';
            document.getElementById('shop-col3-title').innerText = isTD ? 'UPGRADES' : 'UPGRADES - UNLIMITED';

            const mk = (type, key, name, sub, cls) => {
                const d = document.createElement('div');
                const isSel = shopSelected && shopSelected.type === type && shopSelected.key === key;
                d.className = 'shop-item ' + cls + (isSel ? ' selected' : '');
                d.innerHTML = '<div class="shop-item-name">' + name + '</div><div class="shop-item-sub">' + sub + '</div>';
                d.onclick = () => {
                    shopSelected = { type: type, key: key }; shopMessage = '';
                    if (type === 'pad') tdPad = key;
                    renderShop();
                };
                return d;
            };
            const c1 = document.getElementById('shop-skills'), c2 = document.getElementById('shop-ults'), c3 = document.getElementById('shop-upgrades');
            c1.innerHTML = ''; c2.innerHTML = ''; c3.innerHTML = '';
            const addPassive = (p) => {
                const u = passiveEntry(p.id), tier = upgradeTiers[p.id] || 0;
                c3.appendChild(mk('passive', p.id, u.title, 'x' + tier + '  |  next ' + passiveCost(p) + ' pts', tier > 0 ? 'owned' : ''));
            };

            if (isTD) {
                td.pads.forEach((pad, i) => {
                    const t = pad.turret;
                    c1.appendChild(mk('pad', i, 'PAD ' + (i + 1), t ? TD_TURRETS[t.type].name + ' - LV ' + t.level + '/' + TD_TURRET_MAX : 'EMPTY', (t ? 'owned ' : '') + (tdPad === i ? 'selected' : '')));
                });
                for (const key in TD_TURRETS) {
                    const d = TD_TURRETS[key];
                    c2.appendChild(mk('turret', key, d.name, d.price + ' pts  |  range ' + d.range + 'm', ''));
                }
                TD_PASSIVE_IDS.forEach(id => addPassive(SHOP_PASSIVES.find(x => x.id === id)));
                c3.appendChild(mk('repair', 'repair', 'CRYSTAL REPAIR', TD_REPAIR_COST + ' pts  |  +' + TD_REPAIR_AMOUNT + ' HP', ''));
            } else {
                const fill = (el, defs, slot, type) => {
                    for (const key in defs) {
                        const d = defs[key], owned = shopLoadout[slot] === key, dim = shopLoadout[slot] && !owned;
                        const sub = owned ? 'OWNED - LV ' + (shopItemTier[key] || 0) + '/' + d.upgrade.max : d.price + ' pts';
                        el.appendChild(mk(type, key, d.name, sub, (owned ? 'owned ' : '') + (dim ? 'dim' : '')));
                    }
                };
                fill(c1, SHOP_SKILLS, 'skill', 'skill');
                fill(c2, SHOP_ULTS, 'ult', 'ult');
                SHOP_PASSIVES.forEach(addPassive);

                const wEl = document.getElementById('shop-weapons'); wEl.innerHTML = '';
                const open = weaponShopOpen();
                document.getElementById('shop-weapon-title').innerText = open ? 'WEAPONS - OPEN NOW' : 'WEAPONS - OPEN AFTER BOSS STAGES';
                for (const key in SHOP_WEAPONS) {
                    const d = SHOP_WEAPONS[key], owned = shopWeapons.indexOf(d.id) !== -1;
                    const sub = owned ? 'OWNED - LV ' + (shopItemTier[key] || 0) + '/' + d.upgrade.max : (open ? d.price + ' pts' : 'LOCKED');
                    wEl.appendChild(mk('weapon', key, d.name, sub, (owned ? 'owned ' : '') + ((!owned && !open) ? 'dim' : '')));
                }
            }
            renderShopDetail();
        }

        function renderShopDetail() {
            const nameEl = document.getElementById('shop-detail-name'), descEl = document.getElementById('shop-detail-desc'), metaEl = document.getElementById('shop-detail-meta');
            const buyBtn = document.getElementById('shop-buy'), upBtn = document.getElementById('shop-upgrade'), sellBtn = document.getElementById('shop-sell');
            document.getElementById('shop-points').innerText = 'POINTS: ' + player.score;
            buyBtn.disabled = true; upBtn.disabled = true; sellBtn.disabled = true; upBtn.classList.remove('lit');
            const sel = shopSelected;
            const setInfo = (n, d, m) => { nameEl.innerText = n; descEl.innerText = d; metaEl.innerText = m; };

            if (!sel) {
                setInfo('SELECT AN ITEM', gameMode === 'TD'
                    ? 'Click a build pad, then a turret type, then BUY. Click a built pad to UPGRADE (it lights up) or SELL it for half back.'
                    : 'Click any item to inspect it, then BUY, UPGRADE (lights up once you own it) or SELL for half the points back.', '');
            } else if (sel.type === 'pad') {
                const pad = td.pads[sel.key], t = pad.turret;
                if (!t) {
                    setInfo('PAD ' + (sel.key + 1), 'Empty. Pick a turret type in the middle column and press BUY to build it here.', '');
                } else {
                    const d = TD_TURRETS[t.type], st = turretStats(t);
                    setInfo(d.name + '  -  LV ' + t.level + '/' + TD_TURRET_MAX, d.desc,
                        'Damage ' + Math.round(st.damage) + '  |  Range ' + st.range.toFixed(1) + 'm  |  Interval ' + st.rate.toFixed(2) + 's  |  ' +
                        (t.level < TD_TURRET_MAX ? 'Upgrade: ' + d.upBase * (t.level + 1) + ' pts' : 'MAX LEVEL') + '  |  Sell refund: ' + Math.floor(t.spent / 2) + ' pts');
                    sellBtn.disabled = false;
                    if (t.level < TD_TURRET_MAX) { upBtn.disabled = false; upBtn.classList.add('lit'); }
                }
            } else if (sel.type === 'turret') {
                const d = TD_TURRETS[sel.key], pad = tdPad !== null ? td.pads[tdPad] : null;
                setInfo(d.name, d.desc, 'Price: ' + d.price + ' pts  |  Range ' + d.range + 'm  |  ' +
                    (pad ? (pad.turret ? 'PAD ' + (tdPad + 1) + ' IS TAKEN' : 'Will be built on PAD ' + (tdPad + 1)) : 'Select an empty pad first'));
                buyBtn.disabled = !(pad && !pad.turret);
            } else if (sel.type === 'repair') {
                setInfo('CRYSTAL REPAIR', 'Restores ' + TD_REPAIR_AMOUNT + ' crystal HP.', 'Cost ' + TD_REPAIR_COST + ' pts  |  Crystal ' + Math.ceil(td.crystalHp) + '/' + td.crystalMax);
                buyBtn.disabled = td.crystalHp >= td.crystalMax;
            } else if (sel.type === 'passive') {
                const p = SHOP_PASSIVES.find(x => x.id === sel.key), u = passiveEntry(sel.key), tier = upgradeTiers[p.id] || 0;
                setInfo(u.title, 'Repeatable upgrade, buy as many as you like. Next stack: +' + getAddedIncrement(tier, u.getBase) + ' ' + u.unit + '.',
                    'Owned: ' + tier + '  |  Buy: ' + passiveCost(p) + ' pts  |  Sell refund: ' + (tier > 0 ? Math.floor(p.baseCost * tier / 2) : 0) + ' pts');
                buyBtn.disabled = false; sellBtn.disabled = tier <= 0;
            } else if (sel.type === 'weapon') {
                const d = SHOP_WEAPONS[sel.key], owned = shopWeapons.indexOf(d.id) !== -1, tier = shopItemTier[sel.key] || 0, open = weaponShopOpen();
                const slotNote = owned ? '  |  Key ' + (shopWeapons.indexOf(d.id) + 2) : '';
                setInfo(d.name, d.desc + '   UPGRADE - ' + d.upgrade.name + ': ' + d.upgrade.desc + '.',
                    owned ? 'Level ' + tier + '/' + d.upgrade.max + slotNote + '  |  Sell refund: ' + Math.floor((shopSpent[sel.key] || 0) / 2) + ' pts' +
                        (tier < d.upgrade.max ? '  |  Upgrade: ' + d.upgrade.baseCost * (tier + 1) + ' pts' : '  |  MAX LEVEL')
                          : 'Price: ' + d.price + ' pts' + (open ? '' : '  |  Weapon shop opens after a boss stage'));
                if (owned) { sellBtn.disabled = false; if (tier < d.upgrade.max) { upBtn.disabled = false; upBtn.classList.add('lit'); } }
                else buyBtn.disabled = !open;
            } else {
                const defs = sel.type === 'skill' ? SHOP_SKILLS : SHOP_ULTS, slot = sel.type === 'skill' ? 'skill' : 'ult';
                const d = defs[sel.key], owned = shopLoadout[slot] === sel.key, tier = shopItemTier[sel.key] || 0;
                const desc = d.desc + '   UPGRADE - ' + d.upgrade.name + ': ' + d.upgrade.desc + '.';
                if (owned) {
                    setInfo(d.name, desc, 'Level ' + tier + '/' + d.upgrade.max + '  |  Sell refund: ' + Math.floor((shopSpent[sel.key] || 0) / 2) + ' pts' +
                        (tier < d.upgrade.max ? '  |  Upgrade: ' + d.upgrade.baseCost * (tier + 1) + ' pts' : '  |  MAX LEVEL'));
                    sellBtn.disabled = false;
                    if (tier < d.upgrade.max) { upBtn.disabled = false; upBtn.classList.add('lit'); }
                } else if (shopLoadout[slot]) {
                    setInfo(d.name, desc, 'Price: ' + d.price + ' pts  |  Sell your current ' + (slot === 'skill' ? 'skill' : 'ultimate') + ' first (only one allowed)');
                } else {
                    setInfo(d.name, desc, 'Price: ' + d.price + ' pts');
                    buyBtn.disabled = false;
                }
            }
            document.getElementById('shop-msg').innerText = shopMessage;
        }

        function shopBuy() {
            const sel = shopSelected; if (!sel) return;
            if (sel.type === 'turret') {
                const d = TD_TURRETS[sel.key], pad = tdPad !== null ? td.pads[tdPad] : null;
                if (!pad || pad.turret) { shopSay('SELECT AN EMPTY PAD FIRST'); return; }
                if (player.score < d.price) { shopSay('NOT ENOUGH POINTS'); return; }
                player.score -= d.price;
                buildTurret(tdPad, sel.key);
                shopSelected = { type: 'pad', key: tdPad };
            } else if (sel.type === 'repair') {
                if (td.crystalHp >= td.crystalMax) { shopSay('CRYSTAL IS AT FULL HEALTH'); return; }
                if (player.score < TD_REPAIR_COST) { shopSay('NOT ENOUGH POINTS'); return; }
                player.score -= TD_REPAIR_COST;
                td.crystalHp = Math.min(td.crystalMax, td.crystalHp + TD_REPAIR_AMOUNT);
            } else if (sel.type === 'passive') {
                const p = SHOP_PASSIVES.find(x => x.id === sel.key), cost = passiveCost(p);
                if (player.score < cost) { shopSay('NOT ENOUGH POINTS'); return; }
                player.score -= cost;
                upgradeTiers[p.id] = (upgradeTiers[p.id] || 0) + 1;
                applyPassive(p.id);
            } else if (sel.type === 'weapon') {
                const d = SHOP_WEAPONS[sel.key];
                if (!weaponShopOpen()) { shopSay('THE WEAPON SHOP OPENS AFTER A BOSS STAGE'); return; }
                if (shopWeapons.indexOf(d.id) !== -1) { shopSay('ALREADY OWNED'); return; }
                if (player.score < d.price) { shopSay('NOT ENOUGH POINTS'); return; }
                player.score -= d.price;
                shopWeapons.push(d.id); shopSpent[sel.key] = d.price; shopItemTier[sel.key] = 0;
                d.upgrade.apply(0);
                if (d.id === 3) WEAPONS[3].reserve = 15; // fresh shells with a new shotgun
                switchWeapon(d.id);
            } else {
                const defs = sel.type === 'skill' ? SHOP_SKILLS : SHOP_ULTS, slot = sel.type === 'skill' ? 'skill' : 'ult';
                const d = defs[sel.key];
                if (shopLoadout[slot]) { shopSay('SELL YOUR CURRENT ONE FIRST'); return; }
                if (player.score < d.price) { shopSay('NOT ENOUGH POINTS'); return; }
                player.score -= d.price;
                shopLoadout[slot] = sel.key; shopSpent[sel.key] = d.price; shopItemTier[sel.key] = 0;
                d.upgrade.apply(0);
            }
            shopMessage = 'PURCHASED'; updateUI(); renderShop();
        }

        function shopUpgrade() {
            const sel = shopSelected; if (!sel) return;
            if (sel.type === 'pad') {
                const pad = td.pads[sel.key], t = pad.turret; if (!t) return;
                const d = TD_TURRETS[t.type], cost = d.upBase * (t.level + 1);
                if (t.level >= TD_TURRET_MAX) { shopSay('ALREADY MAX LEVEL'); return; }
                if (player.score < cost) { shopSay('NOT ENOUGH POINTS (' + cost + ' NEEDED)'); return; }
                player.score -= cost; t.spent += cost; t.level++;
                rebuildTurretRing(t, pad);
                shopMessage = 'TURRET UPGRADED'; updateUI(); renderShop();
                return;
            }
            if (sel.type === 'passive' || sel.type === 'turret' || sel.type === 'repair') return;
            const d = sel.type === 'weapon' ? SHOP_WEAPONS[sel.key] : (sel.type === 'skill' ? SHOP_SKILLS : SHOP_ULTS)[sel.key];
            const tier = shopItemTier[sel.key] || 0, cost = d.upgrade.baseCost * (tier + 1);
            if (sel.type === 'weapon' && shopWeapons.indexOf(d.id) === -1) return;
            if (tier >= d.upgrade.max) { shopSay('ALREADY MAX LEVEL'); return; }
            if (player.score < cost) { shopSay('NOT ENOUGH POINTS (' + cost + ' NEEDED)'); return; }
            player.score -= cost; shopSpent[sel.key] += cost; shopItemTier[sel.key] = tier + 1;
            d.upgrade.apply(tier + 1);
            shopMessage = d.upgrade.name + ' UPGRADED'; updateUI(); renderShop();
        }

        function shopSell() {
            const sel = shopSelected; if (!sel) return;
            if (sel.type === 'pad') {
                const pad = td.pads[sel.key], t = pad.turret; if (!t) return;
                player.score += Math.floor(t.spent / 2);
                removeTurret(sel.key);
            } else if (sel.type === 'passive') {
                const p = SHOP_PASSIVES.find(x => x.id === sel.key), tier = upgradeTiers[p.id] || 0;
                if (tier <= 0) return;
                player.score += Math.floor(p.baseCost * tier / 2);
                upgradeTiers[p.id] = tier - 1;
                applyPassive(p.id);
            } else if (sel.type === 'weapon') {
                const d = SHOP_WEAPONS[sel.key], idx = shopWeapons.indexOf(d.id);
                if (idx === -1) return;
                player.score += Math.floor((shopSpent[sel.key] || 0) / 2);
                d.upgrade.apply(0);
                shopWeapons.splice(idx, 1); shopSpent[sel.key] = 0; shopItemTier[sel.key] = 0;
                if (currentWeaponId === d.id) switchWeapon(1); // fall back to the pistol
            } else if (sel.type === 'skill' || sel.type === 'ult') {
                const defs = sel.type === 'skill' ? SHOP_SKILLS : SHOP_ULTS, slot = sel.type === 'skill' ? 'skill' : 'ult';
                if (shopLoadout[slot] !== sel.key) return;
                player.score += Math.floor((shopSpent[sel.key] || 0) / 2);
                defs[sel.key].upgrade.apply(0);
                shopLoadout[slot] = null; shopSpent[sel.key] = 0; shopItemTier[sel.key] = 0;
                clearLoadoutStates();
            } else return;
            shopMessage = 'SOLD (50% REFUNDED)'; updateUI(); renderShop();
        }

        // Per-frame update for the shop pseudo-role: the equipped skill's
        // update, the Blade Wave cast punch, Gravity Slam's aim marker and
        // the teleport FOV whoosh, all layered on the shared frame defaults.
        function updateShopLoadout(delta, skillElement) {
            baseFrameDefaults();
            const s = shopSkillDef();
            const fxActive = (shopLoadout.ult === 'BLADE_WAVE') ? updateBladeWaveFx(delta, skillElement) : false;
            if (!fxActive) {
                if (s) s.update(delta, skillElement);
                else skillElement.innerText = (gameMode === 'TD') ? 'PISTOL + TURRETS' : 'NO SKILL EQUIPPED';
            }
            if (shopLoadout.ult === 'GRAVITY_SLAM') updateGravitySlamAim(delta);
            updateJumperShared(delta);
            camera.updateProjectionMatrix();
        }

        // =====================================================================
        // --- Crystal Defense (tower defense) ---
        // Enemies walk TD_PATH to the crystal and detonate on touching it
        // (damaging it, giving no reward). Clear a wave -> bonus points and a
        // shop visit -> next wave. Boss wave every 5th wave.
        // =====================================================================
        function tdCleanup() {
            td.pads.forEach((pad, i) => removeTurret(i));
            td.pads = [];
            td.extraMeshes.forEach(m => scene.remove(m)); td.extraMeshes = [];
            if (td.crystalMesh) { scene.remove(td.crystalMesh); td.crystalMesh = null; }
            td.active = false;
        }

        function setupTDLevel() {
            clearLevelEntities();
            isBossStage = false;
            document.getElementById('boss-ui').style.display = 'none';

            // The path ("the line") enemies follow.
            const pathMat = new THREE.MeshBasicMaterial({ color: 0x5a1a9a, transparent: true, opacity: 0.8 });
            for (let i = 0; i < TD_PATH.length - 1; i++) {
                const a = TD_PATH[i], b = TD_PATH[i + 1];
                const dx = b[0] - a[0], dz = b[1] - a[1], len = Math.hypot(dx, dz);
                const strip = new THREE.Mesh(new THREE.BoxGeometry(len + 2.6, 0.05, 2.6), pathMat);
                strip.position.set((a[0] + b[0]) / 2, 0.03, (a[1] + b[1]) / 2);
                strip.rotation.y = -Math.atan2(dz, dx);
                scene.add(strip); td.extraMeshes.push(strip);
            }
            // Build pads (the shop lets you put a role turret on each).
            td.pads = [];
            TD_PADS.forEach((pp, i) => {
                const disc = new THREE.Mesh(new THREE.CylinderGeometry(2, 2, 0.1, 18), new THREE.MeshBasicMaterial({ color: 0x1d3a5a }));
                disc.position.set(pp[0], 0.06, pp[1]);
                scene.add(disc); td.extraMeshes.push(disc);
                const label = createKiraNumberSprite(i + 1);
                label.scale.set(1.6, 1.6, 1); label.position.set(pp[0], 3.4, pp[1]);
                scene.add(label); td.extraMeshes.push(label);
                td.pads.push({ x: pp[0], z: pp[1], turret: null });
            });
            const spawnRing = new THREE.Mesh(new THREE.TorusGeometry(2, 0.2, 8, 24), new THREE.MeshBasicMaterial({ color: 0xff3344 }));
            spawnRing.rotation.x = Math.PI / 2; spawnRing.position.set(TD_PATH[0][0], 0.2, TD_PATH[0][1]);
            scene.add(spawnRing); td.extraMeshes.push(spawnRing);

            td.crystalMesh = new THREE.Mesh(new THREE.OctahedronGeometry(1.7), new THREE.MeshLambertMaterial({ color: 0x66ffff, emissive: 0x0099aa }));
            td.crystalMesh.position.set(0, 2.2, 0);
            scene.add(td.crystalMesh);

            // Shared code touches these every frame, so park them out of the way.
            waypointBeaconMesh = new THREE.Mesh(new THREE.CylinderGeometry(0.2, 0.2, 150, 8), new THREE.MeshBasicMaterial({ color: 0xff00ff, transparent: true, opacity: 0.0, depthWrite: false, fog: false }));
            waypointBeaconMesh.position.set(0, -500, 0); scene.add(waypointBeaconMesh);
            goalMesh = new THREE.Mesh(new THREE.TorusGeometry(1.2, 0.2, 8, 24), new THREE.MeshBasicMaterial({ color: 0xff00ff }));
            goalMesh.position.set(0, -500, 0); scene.add(goalMesh);

            camera.position.set(-6, player.height, -2);
            camera.rotation.set(0, 0, 0);
            td.wave = 0; td.crystalMax = 100; td.crystalHp = 100;
            td.waveActive = false; td.shopPending = false;
            td.active = true;
            currentLevel = 1;
        }

        function startTDWave() {
            td.wave++; currentLevel = td.wave;
            td.toSpawn = 8 + td.wave * 3; td.spawned = 0; td.spawnTimer = 1.5;
            td.spawnInterval = Math.max(0.5, 1.4 - td.wave * 0.07);
            td.waveActive = true;
            showFeedMessage('WAVE ' + td.wave + ' INCOMING' + (td.wave % 5 === 0 ? ' - BOSS!' : ''), '#ff00ff');
            updateUI();
        }

        function spawnTDEnemy() {
            const w = td.wave;
            let kind = 'normal';
            if (w % 5 === 0 && td.spawned === td.toSpawn - 1) kind = 'boss';
            else { const r = Math.random(); if (w >= 5 && r < 0.2) kind = 'heavy'; else if (w >= 3 && r < 0.5) kind = 'fast'; }

            const baseHp = 40 + (w - 1) * 14;
            const T = {
                normal: { hp: baseHp, speed: 4.5, dmg: 10, scale: 1.0, color: 0xff3333, head: 0xff0000, bonus: 0 },
                fast:   { hp: baseHp * 0.6, speed: 8.0, dmg: 8, scale: 0.8, color: 0xffaa00, head: 0xffff00, bonus: 0 },
                heavy:  { hp: baseHp * 3, speed: 3.2, dmg: 20, scale: 1.5, color: 0x9933ff, head: 0xcc66ff, bonus: 100 },
                boss:   { hp: baseHp * 14, speed: 2.6, dmg: 45, scale: 2.6, color: 0xff00ff, head: 0xff0055, bonus: 1000 }
            }[kind];
            const s = T.scale, sx = TD_PATH[0][0], sz = TD_PATH[0][1];

            const bot = { hp: T.hp, maxHp: T.hp, travel: 0, damage: 0, lastShot: 0, isMinion: (kind === 'normal' || kind === 'fast'), isTD: true, kind: kind, speed: T.speed,
                          crystalDmg: T.dmg, pathIdx: 1, hitScale: s, bonusPts: T.bonus, headY: 1.3 * s, kiraNumber: 0 };
            bot.body = new THREE.Mesh(new THREE.BoxGeometry(0.6 * s, 1.1 * s, 0.6 * s), new THREE.MeshLambertMaterial({ color: T.color, emissive: 0x220000 }));
            bot.head = new THREE.Mesh(new THREE.BoxGeometry(0.4 * s, 0.4 * s, 0.4 * s), new THREE.MeshBasicMaterial({ color: T.head }));
            bot.gun = new THREE.Mesh(new THREE.BoxGeometry(0.01, 0.01, 0.01), new THREE.MeshBasicMaterial({ color: 0x000000 }));
            bot.gun.visible = false;
            bot.body.position.set(sx, 0.55 * s, sz); bot.head.position.set(sx, bot.headY, sz);
            scene.add(bot.body); scene.add(bot.head); scene.add(bot.gun);
            enemies.push(bot);
        }

        // Moves one TD enemy along the path (called from the enemy loop).
        function stepTDEnemy(ent, wd) {
            if (!(ent.stunTimeLeft > 0)) {
                const tgt = TD_PATH[ent.pathIdx];
                const dx = tgt[0] - ent.body.position.x, dz = tgt[1] - ent.body.position.z;
                const d = Math.hypot(dx, dz), step = ent.speed * wd;
                ent.travel += Math.min(d, step);
                if (d <= step) {
                    ent.body.position.x = tgt[0]; ent.body.position.z = tgt[1];
                    if (ent.pathIdx < TD_PATH.length - 1) ent.pathIdx++;
                } else {
                    ent.body.position.x += dx / d * step; ent.body.position.z += dz / d * step;
                    ent.body.rotation.y = Math.atan2(dx, dz);
                }
            }
            ent.head.position.set(ent.body.position.x, ent.headY, ent.body.position.z);
            ent.gun.position.copy(ent.body.position);
        }

        // Per-frame TD logic: spawning, crystal contact, wave end, HUD.
        function updateTD(delta, wd) {
            if (!td.active) return;

            if (td.crystalMesh) {
                td.crystalMesh.rotation.y += delta * 0.8;
                td.crystalMesh.position.y = 2.2 + Math.sin(worldClock * 2) * 0.2;
            }

            updateTurrets(wd);

            if (td.waveActive && td.spawned < td.toSpawn) {
                td.spawnTimer -= wd;
                if (td.spawnTimer <= 0) { spawnTDEnemy(); td.spawned++; td.spawnTimer = td.spawnInterval; }
            }

            for (let i = enemies.length - 1; i >= 0; i--) {
                const e = enemies[i];
                if (!e.isTD) continue;
                if (Math.hypot(e.body.position.x, e.body.position.z) < 2.2) {
                    td.crystalHp = Math.max(0, td.crystalHp - e.crystalDmg);
                    spawnParticleBurst(new THREE.Vector3(e.body.position.x, 1.5, e.body.position.z), 14, 5, 0.25, 0.5);
                    scene.remove(e.body); scene.remove(e.head); scene.remove(e.gun);
                    enemies.splice(i, 1);
                    showFeedMessage('CRYSTAL HIT! -' + e.crystalDmg, '#ff2244');
                }
            }

            if (td.waveActive && td.spawned >= td.toSpawn && !enemies.some(e => e.isTD)) {
                td.waveActive = false;
                const bonus = 200 + td.wave * 50;
                player.score += bonus;
                td.crystalHp = Math.min(td.crystalMax, td.crystalHp + 15);
                showFeedMessage('WAVE CLEARED! +' + bonus + ' POINTS', '#00ffaa');
                td.shopPending = true; td.shopTimer = 0.8;
                updateUI();
            }
            if (td.shopPending) {
                td.shopTimer -= delta;
                if (td.shopTimer <= 0) { td.shopPending = false; openShop('WAVE'); }
            }

            // Keep the player inside the arena.
            const r = Math.hypot(camera.position.x, camera.position.z);
            if (r > 75) { camera.position.x *= 75 / r; camera.position.z *= 75 / r; }

            const left = (td.toSpawn - td.spawned) + enemies.filter(e => e.isTD).length;
            document.getElementById('td-wave-text').innerText = td.waveActive ? ('WAVE ' + td.wave + '  -  ' + left + ' ENEMIES LEFT') : ('WAVE ' + td.wave + ' CLEARED');
            document.getElementById('td-crystal-bar').style.width = Math.max(0, td.crystalHp / td.crystalMax * 100) + '%';
            document.getElementById('td-crystal-text').innerText = 'CRYSTAL ' + Math.ceil(td.crystalHp) + '/' + td.crystalMax;
        }

        // =====================================================================
        // --- TD turrets (each role becomes a turret) ---
        // Turrets target the enemy furthest along the path inside their range.
        // =====================================================================
        function turretStats(t) {
            const d = TD_TURRETS[t.type], L = t.level;
            return { range: d.range * (1 + 0.06 * L), damage: d.damage * (1 + 0.4 * L), rate: Math.max(0.12, d.rate * (1 - 0.06 * L)) };
        }

        function rebuildTurretRing(t, pad) {
            if (t.ring) scene.remove(t.ring);
            const r = turretStats(t).range;
            t.ring = new THREE.Mesh(new THREE.RingGeometry(r - 0.2, r, 48), new THREE.MeshBasicMaterial({ color: TD_TURRETS[t.type].color, transparent: true, opacity: 0.12, side: THREE.DoubleSide, depthWrite: false }));
            t.ring.rotation.x = -Math.PI / 2; t.ring.position.set(pad.x, 0.07, pad.z);
            scene.add(t.ring);
        }

        function buildTurret(padIdx, type) {
            const pad = td.pads[padIdx], d = TD_TURRETS[type];
            const group = new THREE.Group();
            const base = new THREE.Mesh(new THREE.CylinderGeometry(1.0, 1.2, 0.5, 12), new THREE.MeshLambertMaterial({ color: 0x333344 }));
            base.position.y = 0.3; group.add(base);
            const head = new THREE.Group(); head.position.y = 1.2;
            head.add(new THREE.Mesh(new THREE.BoxGeometry(0.9, 0.9, 0.9), new THREE.MeshLambertMaterial({ color: d.color, emissive: 0x111111 })));
            const barrel = new THREE.Mesh(new THREE.BoxGeometry(0.22, 0.22, 1.3), new THREE.MeshBasicMaterial({ color: 0x111111 }));
            barrel.position.z = 0.9; head.add(barrel);
            group.add(head);
            group.position.set(pad.x, 0, pad.z);
            scene.add(group);
            pad.turret = { type: type, level: 0, spent: d.price, group: group, head: head, cd: 0.5, slamCd: 3, ring: null };
            rebuildTurretRing(pad.turret, pad);
        }

        function removeTurret(padIdx) {
            const pad = td.pads[padIdx];
            if (!pad || !pad.turret) return;
            scene.remove(pad.turret.group);
            if (pad.turret.ring) scene.remove(pad.turret.ring);
            pad.turret = null;
        }

        function damageTDEnemy(e, dmg) {
            e.hp -= dmg;
            spawnHitSpark(e.body.position, 0xffcc00);
            if (e.hp <= 0) { const i = enemies.indexOf(e); if (i !== -1) killEnemy(i); }
        }

        function fireTurret(t, pad, st, target) {
            const col = TD_TURRETS[t.type].color;
            spawnHitSpark(new THREE.Vector3(pad.x, 1.8, pad.z), col);
            if (t.type === 'SHOTGUNNER') {
                const tp = target.body.position.clone();
                enemies.slice().forEach(e => { if (e.isTD && e !== target && e.body.position.distanceTo(tp) <= 3) damageTDEnemy(e, st.damage * 0.5); });
                damageTDEnemy(target, st.damage);
            } else if (t.type === 'ASSASSIN') {
                enemies.slice().forEach(e => { if (e.isTD && Math.hypot(e.body.position.x - pad.x, e.body.position.z - pad.z) <= st.range) damageTDEnemy(e, st.damage); });
            } else if (t.type === 'JUMPER') {
                t.slamCd -= st.rate;
                if (t.slamCd <= 0) {
                    t.slamCd = 6;
                    const tp = target.body.position.clone();
                    enemies.forEach(e => { if (e.isTD && e.body.position.distanceTo(tp) <= 5) applyStun(e, 2.0); });
                    spawnSlamVisual(tp.x, tp.z, 5);
                }
                damageTDEnemy(target, st.damage);
            } else if (t.type === 'KIRA') {
                damageTDEnemy(target, target.kind === 'boss' ? target.maxHp * 0.15 : target.hp);
            }
        }

        function updateTurrets(wd) {
            for (const pad of td.pads) {
                const t = pad.turret; if (!t) continue;
                t.cd -= wd;
                const st = turretStats(t);
                let target = null, bestTravel = -1;
                for (const e of enemies) {
                    if (!e.isTD) continue;
                    if (Math.hypot(e.body.position.x - pad.x, e.body.position.z - pad.z) <= st.range && (e.travel || 0) > bestTravel) { bestTravel = e.travel || 0; target = e; }
                }
                if (target) t.head.rotation.y = Math.atan2(target.body.position.x - pad.x, target.body.position.z - pad.z);
                if (t.cd > 0 || !target) continue;
                t.cd = st.rate;
                fireTurret(t, pad, st, target);
            }
        }

        function openUpgradeMenu() {
            if (gameMode === 'SHOP') { openShop('PORTAL'); return; }
            gameState = "UPGRADE";
            document.exitPointerLock();
            
            let available = UPGRADE_REGISTRY.filter(u => u.roles.includes(selectedRole) && (!u.maxTier || (upgradeTiers[u.id] || 0) < u.maxTier));
            let shuffled = [...available].sort(() => 0.5 - Math.random());
            let choices = shuffled.slice(0, 3);
            
            let optionsContainer = document.getElementById('upgrade-options');
            optionsContainer.innerHTML = '';
            
            choices.forEach(upg => {
                let currentTier = upgradeTiers[upg.id] || 0;
                let isUnlock = (currentTier === 0);
                let isMaxable = (upg.maxTier === 1);

                let addedAmount = getAddedIncrement(currentTier, upg.getBase);
                let totalAfter = getTierBonus(currentTier + 1, upg.getBase);

                let badgeHtml = isMaxable
                    ? `<span class="upgrade-badge badge-max">MAX LEVEL PASSIVE</span>`
                    : (isUnlock 
                        ? `<span class="upgrade-badge badge-unlock">NEW ABILITY</span>` 
                        : `<span class="upgrade-badge badge-upgrade">LEVEL ${currentTier + 1}</span>`);

                let statTextHtml = isMaxable 
                    ? `Unlocks Deflect Bullets on Slash` 
                    : (isUnlock
                        ? `Grants +${addedAmount} ${upg.unit}`
                        : `+${addedAmount} ${upg.unit} (Total: +${totalAfter} ${upg.unit})`);

                let nextTextHtml = isMaxable
                    ? `Slashes deflect enemy projectiles with 220% returned velocity!`
                    : (isUnlock
                        ? `Unlocks this passive trait into your arsenal`
                        : `Current Tier Level: ${currentTier} -> Upgrading to Tier ${currentTier + 1}`);

                let card = document.createElement('div');
                card.className = 'upgrade-card';
                card.innerHTML = `
                    ${badgeHtml}
                    <div class="upgrade-title">${upg.title}</div>
                    <div class="upgrade-stat">${statTextHtml}</div>
                    <div class="upgrade-next">${nextTextHtml}</div>
                `;
                card.onclick = () => selectUpgrade(upg);
                optionsContainer.appendChild(card);
            });
            
            document.getElementById('upgrade-screen').style.display = 'flex';
        }

        // Shared by the classic upgrade pick and the shop's CONTINUE button.
        function advanceLevelCore() {
            currentLevel++; player.score += 400; player.timeLeft += 10;
            if (currentLevel % 2 === 0 && mazeSize < 25) mazeSize += 2;
            generateNextLevel();
        }

        function selectUpgrade(upgrade) {
            upgradeTiers[upgrade.id] = (upgradeTiers[upgrade.id] || 0) + 1;
            let currentTier = upgradeTiers[upgrade.id];
            
            upgrade.apply(currentTier, upgrade.getBase);

            document.getElementById('upgrade-screen').style.display = 'none';
            document.getElementById('loading-screen').style.display = 'flex';

            setTimeout(() => {
                advanceLevelCore();
                document.getElementById('loading-screen').style.display = 'none';
                gameState = "PLAYING";
                document.body.requestPointerLock();
                updateUI();
            }, 100);
        }

        function clearLevelEntities() {
            objects.forEach(obj => scene.remove(obj));
            gems.forEach(g => scene.remove(g));
            enemies.forEach(e => { scene.remove(e.body); scene.remove(e.head); scene.remove(e.gun); if (e.kiraSprite) scene.remove(e.kiraSprite); });
            playerBullets.forEach(b => scene.remove(b.mesh));
            enemyBullets.forEach(b => scene.remove(b.mesh));
            waveProjectiles.forEach(w => scene.remove(w.mesh));
            healthPickups.forEach(h => scene.remove(h));
            locators.forEach(l => scene.remove(l));
            if (goalMesh) scene.remove(goalMesh);
            if (waypointBeaconMesh) scene.remove(waypointBeaconMesh);
            if (bossBot) { clearMirrorFx(); scene.remove(bossBot.body); scene.remove(bossBot.head); if (bossBot.kiraSprite) scene.remove(bossBot.kiraSprite); bossBot = null; }
            
            objects = []; gems = []; enemies = []; playerBullets = []; enemyBullets = []; waveProjectiles = []; healthPickups = []; locators = [];
            locatorTimer = 0; player.beaconTimeLeft = 0;
            tdCleanup();
        }

        function generateNextLevel() {
            clearLevelEntities();
            isBossStage = (currentLevel % 3 === 0);

            document.getElementById('boss-ui').style.display = isBossStage ? 'block' : 'none';

            if (isBossStage) bossRoundMultiplier = Math.pow(2, Math.floor(currentLevel / 3) - 1);

            const beaconMat = new THREE.MeshBasicMaterial({ color: 0xff00ff, transparent: true, opacity: 0.0, depthWrite: false, fog: false });
            waypointBeaconMesh = new THREE.Mesh(new THREE.CylinderGeometry(0.2, 0.2, 150, 8), beaconMat);
            scene.add(waypointBeaconMesh);

            if (isBossStage) {
                mazeOffset = 0;
                const ringMat = new THREE.MeshLambertMaterial({ color: 0x440033, emissive: 0x110011 });
                for (let a = 0; a < Math.PI * 2; a += 0.25) {
                    let w = new THREE.Mesh(new THREE.BoxGeometry(4, 8, 4), ringMat);
                    w.position.set(Math.cos(a) * 26, 4, Math.sin(a) * 26);
                    scene.add(w); objects.push(w);
                }

                // Every second boss stage (6, 12, 18...) is a MIRROR boss that copies
                // the player's own skill and ultimate (see updateBossMirror). Kira, who
                // has neither, and loadouts with nothing copyable just get the normal boss.
                const mirrorSet = (currentLevel % MIRROR_BOSS_INTERVAL === 0) ? pickMirrorSet() : null;
                let calculatedBossHp = Math.round(1200 * bossRoundMultiplier * (mirrorSet ? 0.8 : 1));
                let calculatedBossDmg = 25 * bossRoundMultiplier; 
                bossBot = { hp: calculatedBossHp, maxHp: calculatedBossHp, damage: calculatedBossDmg, lastShot: worldClock };
                if (mirrorSet) {
                    bossBot.mirror = { skill: mirrorSet.skill, ult: mirrorSet.ult, state: 'IDLE', timer: 4.0, useUlt: false, which: null, fx: [], data: {} };
                    showFeedMessage('MIRROR BOSS - IT COPIES YOUR SKILLS!', '#ff00ff');
                }
                document.getElementById('boss-label').innerText = mirrorSet ? 'MIRROR OVERLORD' : 'CYBER OVERLORD';
                
                bossBot.body = new THREE.Mesh(new THREE.BoxGeometry(2.5, 4.0, 2.5), new THREE.MeshLambertMaterial({ color: 0xff00ff, emissive: 0x330033 }));
                bossBot.head = new THREE.Mesh(new THREE.BoxGeometry(1.5, 1.2, 1.5), new THREE.MeshBasicMaterial({ color: 0xff0055 }));
                bossBot.body.position.set(0, 2.0, -10);
                bossBot.head.position.set(0, 4.6, -10);
                scene.add(bossBot.body); scene.add(bossBot.head);

                // --- Kira Specific: boss gets a much bigger Death Note number ---
                bossBot.kiraNumber = Math.floor(Math.random() * 900) + 100;
                if (selectedRole === 'KIRA') {
                    bossBot.kiraSprite = createKiraNumberSprite(bossBot.kiraNumber);
                    scene.add(bossBot.kiraSprite);
                }

                document.getElementById('boss-bar').style.width = "100%";

                for (let i = 0; i < 6; i++) {
                    let minionPos = getRandomArenaPerimeter();
                    spawnEnemyBot(minionPos.x, minionPos.z, true);
                }

                camera.position.set(0, player.height, 18);
                goalMesh = new THREE.Mesh(new THREE.TorusGeometry(1.2, 0.2, 8, 24), new THREE.MeshBasicMaterial({ color: 0xff00ff }));
                goalMesh.position.set(0, -500, 0); 
                scene.add(goalMesh);
                waypointBeaconMesh.position.set(0, -500, 0);
            } else {
                rawGrid = createDFSGrid(mazeSize);
                mazeOffset = (mazeSize * cellSize) / 2;
                const wallMat = new THREE.MeshLambertMaterial({ color: 0x110033, emissive: 0x220055, transparent: true, opacity: 0.7 }); 

                let activeSpawnChance = initialSpawnChance + ((currentLevel - 1) * spawnChanceGrowth);
                if (activeSpawnChance > 0.65) activeSpawnChance = 0.65;

                for(let r = 0; r < mazeSize; r++) {
                    for(let c = 0; c < mazeSize; c++) {
                        if(rawGrid[r][c] === 1) {
                            const wall = new THREE.Mesh(new THREE.BoxGeometry(cellSize, 4.5, cellSize), wallMat);
                            wall.position.set((c * cellSize) - mazeOffset, 2.25, (r * cellSize) - mazeOffset);
                            scene.add(wall); objects.push(wall);
                        } else if (r > 1 && c > 1 && (r !== mazeSize-2 || c !== mazeSize-2)) {
                            let wx = (c * cellSize) - mazeOffset;
                            let wz = (r * cellSize) - mazeOffset;
                            let rand = Math.random();
                            if (rand < 0.05) spawnGem(wx, wz);
                            else if (rand >= 0.05 && rand < 0.05 + activeSpawnChance) spawnEnemyBot(wx, wz, false); 
                        }
                    }
                }

                camera.position.set((1 * cellSize) - mazeOffset, player.height, (1 * cellSize) - mazeOffset);
                let goalX = ((mazeSize - 2) * cellSize) - mazeOffset;
                let goalZ = ((mazeSize - 2) * cellSize) - mazeOffset;
                
                goalMesh = new THREE.Mesh(new THREE.TorusGeometry(0.9, 0.15, 8, 24), new THREE.MeshBasicMaterial({ color: 0xff00ff }));
                goalMesh.position.set(goalX, 1.8, goalZ);
                scene.add(goalMesh);
                waypointBeaconMesh.position.set(goalX, 75, goalZ);
            }

            camera.rotation.set(0, 0, 0);
            player.currentHeight = player.height;
            player.yVelocity = 0; player.isGrounded = true;
            player.dashMomentum.set(0,0,0); player.currentMoveVel.set(0,0,0);
            buildWeaponMesh();
        }

        function createDFSGrid(size) {
            let grid = Array(size).fill(0).map(() => Array(size).fill(1));
            function carve(x, y) {
                grid[y][x] = 0;
                const dirs = [[0, -2], [0, 2], [-2, 0], [2, 0]].sort(() => Math.random() - 0.5);
                for (let [dx, dy] of dirs) {
                    let nx = x + dx, ny = y + dy;
                    if (ny > 0 && ny < size - 1 && nx > 0 && nx < size - 1 && grid[ny][nx] === 1) {
                        grid[y + dy / 2][x + dx / 2] = 0; carve(nx, ny);
                    }
                }
            }
            carve(1, 1); return grid;
        }

        function spawnGem(x, z) {
            const gem = new THREE.Mesh(new THREE.OctahedronGeometry(0.25), new THREE.MeshBasicMaterial({ color: 0x00ffff }));
            gem.position.set(x, 1.2, z); scene.add(gem); gems.push(gem);
        }

        function spawnEnemyBot(x, z, isMinion = false) {
            let computedHp = BASE_ENEMY_HP + ((currentLevel - 1) * HP_GROWTH_PER_STAGE);
            let computedDmg = BASE_ENEMY_DMG + ((currentLevel - 1) * DMG_GROWTH_PER_STAGE);

            if (isBossStage) {
                computedHp = (isMinion ? 50 : 70) * bossRoundMultiplier;
                computedDmg = (isMinion ? 15 : 20) * bossRoundMultiplier;
            }

            const bot = { hp: computedHp, damage: computedDmg, lastShot: worldClock + Math.random(), isMinion: isMinion }; 
            const bMat = new THREE.MeshLambertMaterial({ color: isMinion ? 0xffaa00 : 0xff3333, emissive: isMinion ? 0x332200 : 0x440000 });
            
            bot.body = new THREE.Mesh(new THREE.BoxGeometry(0.6, 1.1, 0.6), bMat);
            bot.head = new THREE.Mesh(new THREE.BoxGeometry(0.4, 0.4, 0.4), new THREE.MeshBasicMaterial({ color: isMinion ? 0xffff00 : 0xff0000 }));
            bot.gun = new THREE.Mesh(new THREE.BoxGeometry(0.1, 0.1, 0.45), new THREE.MeshBasicMaterial({ color: 0x222222 }));

            bot.body.position.set(x, 0.55, z); bot.head.position.set(x, 1.3, z);
            scene.add(bot.body); scene.add(bot.head); scene.add(bot.gun);

            // --- Kira Specific: Death Note number ---
            // Every enemy gets a random digit regardless of role (cheap, and
            // means the number is already "decided" the instant they spawn);
            // the floating sprite that displays it is only created when Kira
            // is actually the selected role, since no other role reads it.
            bot.kiraNumber = Math.floor(Math.random() * 10) * currentLevel; // the displayed number IS the kill code now
            if (selectedRole === 'KIRA') {
                bot.kiraSprite = createKiraNumberSprite(bot.kiraNumber);
                scene.add(bot.kiraSprite);
            }

            enemies.push(bot);
        }

        function triggerGameOver() {
            gameState = "GAMEOVER";
            document.exitPointerLock();
            setHUDVisibility('none');
            document.getElementById('boss-ui').style.display = 'none';
            document.getElementById('gameover-stats').innerHTML = (gameMode === 'TD') ? `WAVE REACHED: ${td.wave}<br>FINAL POINTS: ${player.score}` : `STAGE REACHED: ${currentLevel}<br>FINAL SCORE: ${player.score}`;
            document.getElementById('gameover-screen').style.display = 'flex';
        }

        function restartGame() {
            document.getElementById('gameover-screen').style.display = 'none';
            document.getElementById('loading-screen').style.display = 'flex';

            setTimeout(() => {
                resetRunState();
                buildWeaponMesh();
                beginRunLevel();
                finishRunStart();
            }, 100);
        }

        function updateUI() {
            let hpVal = Math.max(0, Math.ceil(player.health));
            document.getElementById('hp-counter').innerText = hpVal;
            document.getElementById('max-hp-counter').innerText = player.maxHealth;
            
            let hpPercentage = Math.max(0, (player.health / player.maxHealth) * 100);
            document.getElementById('player-hp-bar').style.width = hpPercentage + "%";

            document.getElementById('score-counter').innerText = player.score;
            document.getElementById('level-counter').innerText = isBossStage ? currentLevel + " [BOSS]" : currentLevel;
            
            const w = WEAPONS[currentWeaponId];
            if (w) {
                document.getElementById('weapon-name').innerText = w.name;
                document.getElementById('ammo-display').innerText = "AMMO: " + (w.reserve === Infinity ? "∞" : w.reserve);
            }

            let percentage = (player.ultCharge / player.ultRequiredKills) * 100;
            document.getElementById('ult-bar').style.width = percentage + "%";
        }

        function animate() {
            requestAnimationFrame(animate);
            const delta = clock.getDelta();
            if (IS_MOBILE) updateMobileUI();
            let worldDelta = delta;
            if (kiraTimeSlowTimeLeft > 0) {
                kiraTimeSlowTimeLeft -= delta;
                worldDelta = delta * KIRA_TIME_SLOW_FACTOR;
            }
            worldClock += worldDelta;

            if (gameState === "MENU") {
                menuRotationAngle += 0.15 * delta;
                camera.position.set(Math.cos(menuRotationAngle) * 12, 5, Math.sin(menuRotationAngle) * 12);
                camera.lookAt(0, 1.5, 0);
            } 
            else if (gameState === "PLAYING") {
                if (gameMode === 'TD') {
                    if (td.crystalHp <= 0) { triggerGameOver(); return; }
                } else {
                    player.timeLeft -= delta;
                    document.getElementById('time-counter').innerText = Math.max(0, Math.ceil(player.timeLeft));
                    if (player.timeLeft <= 0 || player.health <= 0) { triggerGameOver(); return; }
                }

                if (currentWeaponId === 2 && weaponMesh) {
                    weaponMesh.rotation.x += (0.2 - weaponMesh.rotation.x) * 0.18;
                    weaponMesh.rotation.y += (-0.4 - weaponMesh.rotation.y) * 0.18;
                    weaponMesh.rotation.z += (0.0 - weaponMesh.rotation.z) * 0.18;
                    weaponMesh.position.x += (0.3 - weaponMesh.position.x) * 0.18;
                    weaponMesh.position.y += (-0.3 - weaponMesh.position.y) * 0.18;
                    weaponMesh.position.z += (-0.5 - weaponMesh.position.z) * 0.18;
                } else if (currentWeaponId !== 4 && weaponMesh) {
                    weaponMesh.position.z += (-0.45 - weaponMesh.position.z) * 0.15;
                    weaponMesh.rotation.x += (0 - weaponMesh.rotation.x) * 0.2;
                }

                // --- Shared: Gun Recoil recovery ---
                // Settles the camera kick from applyRecoilKick() back down/
                // centered over time, independent of whatever the mouse is
                // doing this frame (see the comment on recoilPitch/recoilYaw above).
                if (recoilPitch > 0.0001) {
                    let pitchRecover = recoilPitch * Math.min(RECOIL_RECOVERY_SPEED * delta, 1.0);
                    camera.rotation.x -= pitchRecover;
                    recoilPitch -= pitchRecover;
                    camera.rotation.x = Math.max(-Math.PI / 2.3, Math.min(Math.PI / 2.3, camera.rotation.x));
                }
                if (Math.abs(recoilYaw) > 0.0001) {
                    let yawRecover = recoilYaw * Math.min(RECOIL_RECOVERY_SPEED * delta, 1.0);
                    camera.rotation.y -= yawRecover;
                    recoilYaw -= yawRecover;
                }

                if (isShooting) shoot();
                if (player.dashCooldown > 0) player.dashCooldown -= delta;

                if (onKillBuffs.timer > 0) {
                    onKillBuffs.timer -= delta;
                    if (onKillBuffs.timer <= 0) onKillBuffs.killCount = 0;
                }

                // Each "X per kill" upgrade's own tier sets both its per-kill
                // percent AND how many stacks of the current streak it can
                // benefit from -- higher tier = higher cap, so a streak can't
                // scale forever off one cheap upgrade.
                let frStacks = Math.min(onKillBuffs.killCount, getKillBuffCap(upgradeTiers.killFireRate));
                let dmgStacks = Math.min(onKillBuffs.killCount, getKillBuffCap(upgradeTiers.killDamage));
                let spdStacks = Math.min(onKillBuffs.killCount, getKillBuffCap(upgradeTiers.killSpeed));

                let extraFrPct = getTierBonus(upgradeTiers.killFireRate, 5) * frStacks;
                let extraDmgPct = getTierBonus(upgradeTiers.killDamage, 5) * dmgStacks;
                let extraSpdPct = getTierBonus(upgradeTiers.killSpeed, 5) * spdStacks;

                player.fireRateModifier = Math.max(0.1, 1.0 - (extraFrPct / 100));
                player.damageModifier = 1.0 + (extraDmgPct / 100);
                player.killSpeedBonusPct = extraSpdPct;

                let buffText = "BUFFS: ";
                if (onKillBuffs.killCount > 0 && (upgradeTiers.killFireRate > 0 || upgradeTiers.killDamage > 0 || upgradeTiers.killSpeed > 0)) {
                    buffText += `[${onKillBuffs.killCount} KILLS] FR: -${extraFrPct}% | DMG: +${extraDmgPct}% | SPD: +${extraSpdPct}% (${onKillBuffs.timer.toFixed(1)}s)`;
                } else {
                    buffText += "NONE";
                }
                document.getElementById('buff-ui').innerText = buffText;

                locatorTimer += delta;
                if (locatorTimer >= 10.0) {
                    locatorTimer = 0;
                    let targetSpot = getRandomEmptyCell();
                    spawnLocator(targetSpot.x, targetSpot.z);
                }

                if (player.beaconTimeLeft > 0 && waypointBeaconMesh) {
                    player.beaconTimeLeft -= delta;
                    waypointBeaconMesh.material.opacity = (0.25 + Math.abs(Math.sin(clock.getElapsedTime() * 5.0)) * 0.55);
                    if (player.beaconTimeLeft <= 0) waypointBeaconMesh.material.opacity = 0.0;
                }

                updateSlashEffects(delta);
                updateSlamEffects(delta);
                updateDeathParticles(delta);
                updateHitSparks(delta);
                updateStun(delta);

                const skillElement = document.getElementById('skill-ui');
                const activeRoleCfg = ROLES[selectedRole];
                if (activeRoleCfg && activeRoleCfg.updateSkill) activeRoleCfg.updateSkill(delta, skillElement);
                if (player.slowTimeLeft > 0) { player.slowTimeLeft -= delta; player.speed *= 0.35; } // boss slam slow
                if (player.killSpeedBonusPct > 0) player.speed *= (1 + player.killSpeedBonusPct / 100); // Momentum Surge, layered on top of whatever the role just set

                const crosshairEl = document.getElementById('crosshair');
                if (currentWeaponId === 3) {
                    let targetSize = player.isGrounded ? '80px' : '110px'; 
                    crosshairEl.style.width = crosshairEl.style.height = targetSize;
                } else {
                    crosshairEl.style.width = crosshairEl.style.height = '20px';
                }

                const moveIn = getMoveInput();
                let fDir = moveIn.f;
                let sDir = moveIn.s;

                // Phantom Rush no longer overrides movement -- it's a speed
                // multiplier applied to player.speed (see updateAssassinSkill),
                // so it flows through this normal WASD blend like any other
                // speed buff instead of needing a special case here.
                let targetDir = new THREE.Vector3(sDir, 0, -fDir).normalize().applyQuaternion(camera.quaternion).setY(0).normalize();
                // analog: a half-pushed joystick walks at half speed (keyboard input is always 0 or 1)
                let targetVelocity = targetDir.multiplyScalar(player.speed * Math.min(1, Math.hypot(sDir, fDir)));
                player.currentMoveVel.lerp(targetVelocity, Math.min(((fDir !== 0 || sDir !== 0) ? 9.5 : 6.5) * delta, 1.0));
                player.dashMomentum.multiplyScalar(Math.exp(-4.5 * delta)); 

                if (player.dashMomentum.length() > 6.0 && upgradeTiers.dashDamage > 0) {
                    let impactDmg = getTierBonus(upgradeTiers.dashDamage, 40) * player.damageModifier;
                    for (let eIdx = enemies.length - 1; eIdx >= 0; eIdx--) {
                        let enemy = enemies[eIdx]; if (!enemy || !enemy.body) continue;
                        if (camera.position.distanceTo(enemy.body.position) <= 1.6) {
                            enemy.hp -= impactDmg * delta * 10;
                            if (enemy.hp <= 0) {
                                killEnemy(eIdx);
                            }
                        }
                    }
                }

                player.velocity.x = player.currentMoveVel.x + player.dashMomentum.x;
                player.velocity.z = player.currentMoveVel.z + player.dashMomentum.z;

                if (!player.isGrounded) {
                    player.yVelocity -= player.gravity * delta;
                    player.currentHeight += player.yVelocity * delta;
                    if (player.currentHeight <= player.height) {
                        player.currentHeight = player.height; player.yVelocity = 0; player.isGrounded = true;
                    }
                }
                camera.position.y = player.currentHeight;

                camera.position.x += player.velocity.x * delta;
                objects.forEach(obj => {
                    let box = wallBox(obj);
                    if(camera.position.x > box.min.x - 0.45 && camera.position.x < box.max.x + 0.45 && camera.position.z > box.min.z - 0.45 && camera.position.z < box.max.z + 0.45) camera.position.x -= player.velocity.x * delta;
                });

                camera.position.z += player.velocity.z * delta;
                objects.forEach(obj => {
                    let box = wallBox(obj);
                    if(camera.position.x > box.min.x - 0.45 && camera.position.x < box.max.x + 0.45 && camera.position.z > box.min.z - 0.45 && camera.position.z < box.max.z + 0.45) camera.position.z -= player.velocity.z * delta;
                });

                if (isBossStage && bossBot && bossBot.body) {
                    bossBot.body.lookAt(camera.position.x, bossBot.body.position.y, camera.position.z);
                    bossBot.head.lookAt(camera.position.x, bossBot.head.position.y, camera.position.z);
                    if (bossBot.mirror) updateBossMirror(worldDelta);
                    if (!(bossBot.stunTimeLeft > 0) && !(bossBot.mirror && bossBot.mirror.state !== 'IDLE') && worldClock - bossBot.lastShot > 1.1) { 
                        enemyShoot(bossBot, true); bossBot.lastShot = worldClock;
                    }
                }

                for (let wIdx = waveProjectiles.length - 1; wIdx >= 0; wIdx--) {
                    let wave = waveProjectiles[wIdx]; wave.life -= delta;
                    wave.mesh.position.addScaledVector(wave.dir, wave.speed * delta);

                    for (let eIdx = enemies.length - 1; eIdx >= 0; eIdx--) {
                        let enemy = enemies[eIdx]; if (!enemy || !enemy.body) continue;
                        if (!wave.hitEnemies.has(enemy) && wave.mesh.position.distanceTo(enemy.body.position) <= (wave.radius || 2.5) + 0.25) {
                            wave.hitEnemies.add(enemy);
                            enemy.hp -= wave.damage;
                            if (enemy.hp <= 0) {
                                killEnemy(eIdx);
                            }
                        }
                    }

                    if (bossBot && bossBot.body && !wave.hitEnemies.has(bossBot) && wave.mesh.position.distanceTo(bossBot.body.position) <= (wave.radius || 2.5) + 1.25) {
                        wave.hitEnemies.add(bossBot);
                        bossBot.hp -= wave.damage;
                        updateBossBar(); checkBossDeath();
                    }

                    if (wave.life <= 0) { scene.remove(wave.mesh); waveProjectiles.splice(wIdx, 1); }
                }

                for (let bIdx = playerBullets.length - 1; bIdx >= 0; bIdx--) {
                    let b = playerBullets[bIdx]; b.life -= delta;
                    let prevPos = b.mesh.position.clone();
                    b.mesh.position.addScaledVector(b.dir, b.speed * delta);
                    let hitTarget = false;

                    for (let wIdx = 0; wIdx < objects.length; wIdx++) {
                        if (wallBox(objects[wIdx]).containsPoint(b.mesh.position)) { hitTarget = true; spawnHitSpark(b.mesh.position, 0xffcc00); break; }
                    }

                    if (!hitTarget && isBossStage && bossBot && bossBot.body) {
                        if (new THREE.Box3().setFromObject(bossBot.body).containsPoint(b.mesh.position) || new THREE.Box3().setFromObject(bossBot.head).containsPoint(b.mesh.position)) {
                            hitTarget = true;
                            if (!b.isRocket) { bossBot.hp -= b.damage; updateBossBar(); checkBossDeath(); spawnHitSpark(b.mesh.position, 0xff3333); }
                        }
                    }

                    if (!hitTarget) {
                        // Swept check against the whole segment the bullet just
                        // travelled this frame, not just its new position -- a
                        // point-only check can step clean past a very close
                        // enemy in a single frame (e.g. muzzle already almost
                        // touching them), letting the bullet "pass through".
                        for (let eIdx = enemies.length - 1; eIdx >= 0; eIdx--) {
                            let enemy = enemies[eIdx]; if (!enemy || !enemy.body) continue;
                            // Two separate hit volumes: a sphere on the actual head
                            // (checked first) and one on the body. The old single
                            // body-centred sphere barely reached the head mesh, so
                            // shots aimed at the face landed at the neck or missed.
                            const hs = enemy.hitScale || 1;
                            const seg = new THREE.Line3(prevPos, b.mesh.position);
                            let closest = null, isHead = false;
                            if (!b.isRocket && enemy.head) {
                                const hc = seg.closestPointToPoint(enemy.head.position, true, new THREE.Vector3());
                                if (hc.distanceTo(enemy.head.position) <= 0.36 * hs) { closest = hc; isHead = true; }
                            }
                            if (!closest) {
                                const bc = seg.closestPointToPoint(enemy.body.position, true, new THREE.Vector3());
                                if (bc.distanceTo(enemy.body.position) <= (b.isRocket ? 1.5 : 0.6) * hs) closest = bc;
                            }
                            if (closest) {
                                hitTarget = true;
                                if (!b.isRocket) {
                                    enemy.hp -= isHead ? b.damage * 2.5 : b.damage;
                                    spawnHitSpark(closest, isHead ? 0xffff00 : 0xff3333);
                                    if (isHead) {
                                        player.score += 50;
                                        showFeedMessage("HEADSHOT! (+50)", "#ff00ff");
                                    }
                                    if (enemy.hp <= 0) {
                                        killEnemy(eIdx);
                                    }
                                }
                                break;
                            }
                        }
                    }

                    if (b.isRocket && (hitTarget || b.life <= 0)) { triggerRocketExplosion(b.mesh.position, b.splashRadius, b.damage); hitTarget = true; }
                    if (hitTarget || b.life <= 0) { scene.remove(b.mesh); playerBullets.splice(bIdx, 1); }
                }

                for (let ebIdx = enemyBullets.length - 1; ebIdx >= 0; ebIdx--) {
                    let eb = enemyBullets[ebIdx]; eb.life -= worldDelta;
                    eb.mesh.position.addScaledVector(eb.dir, eb.speed * worldDelta);
                    let hitTarget = false;

                    for (let wIdx = 0; wIdx < objects.length; wIdx++) {
                        if (wallBox(objects[wIdx]).containsPoint(eb.mesh.position)) { hitTarget = true; break; }
                    }

                    if (!hitTarget) {
                        const bdx = eb.mesh.position.x - camera.position.x, bdz = eb.mesh.position.z - camera.position.z, bdy = eb.mesh.position.y - camera.position.y;
                        // "flat" bullets (the mirror boss's wave) ignore height but can be jumped over
                        const dist = eb.flat ? Math.hypot(bdx, bdz) : Math.hypot(bdx, bdy, bdz);
                        const cleared = eb.flat && camera.position.y > 2.9;
                        if (!cleared && dist < (eb.radius || 0.6)) { hitTarget = true; applyPlayerDamage(eb.damage); }
                    }
                    if (hitTarget || eb.life <= 0) { scene.remove(eb.mesh); enemyBullets.splice(ebIdx, 1); }
                }

                gems.forEach((gem, idx) => {
                    if (camera.position.distanceTo(gem.position) < 1.2) {
                        scene.remove(gem); gems.splice(idx, 1);
                        player.timeLeft += 4; player.score += 100;
                        showFeedMessage("+4s TIME RECOVERED", "#00ffff");
                        updateUI();
                    }
                });

                healthPickups.forEach((pack, idx) => {
                    if (camera.position.distanceTo(pack.position) < 1.2) {
                        scene.remove(pack); healthPickups.splice(idx, 1);
                        let healAmount = Math.min(25, player.maxHealth - player.health);
                        player.health += healAmount;
                        showFeedMessage(`+${healAmount} HP RECOVERED`, "#00ffaa");
                        updateUI();
                    }
                });

                locators.forEach((loc, idx) => {
                    if (camera.position.distanceTo(loc.position) < 1.2) {
                        scene.remove(loc); locators.splice(idx, 1); player.beaconTimeLeft = 12.0; 
                        showFeedMessage("BEACON ACTIVATED", "#ffff00");
                    }
                });

                enemies.forEach(ent => {
                    if (ent.isTD) { stepTDEnemy(ent, worldDelta); return; }
                    let dist = ent.body.position.clone().setY(0).distanceTo(camera.position.clone().setY(0));
                    let dirToPlayer = new THREE.Vector3().subVectors(camera.position, ent.body.position).setY(0).normalize();
                    
                    if(dist > 1.5 && dist < (ent.isMinion ? 35 : 18)) {
                        let mSpeed = ent.isMinion ? 5.8 : 3.8; 
                        let moveX = dirToPlayer.x * mSpeed * worldDelta;
                        let moveZ = dirToPlayer.z * mSpeed * worldDelta;
                        ent.body.position.x += moveX; ent.body.position.z += moveZ;

                        objects.forEach(obj => {
                            let wBox = wallBox(obj);
                            if (ent.body.position.x > wBox.min.x - 0.4 && ent.body.position.x < wBox.max.x + 0.4 && ent.body.position.z > wBox.min.z - 0.4 && ent.body.position.z < wBox.max.z + 0.4) {
                                ent.body.position.x -= moveX; ent.body.position.z -= moveZ;
                            }
                        });
                        ent.head.position.set(ent.body.position.x, 1.3, ent.body.position.z);
                    }
                    
                    ent.body.lookAt(camera.position.x, ent.body.position.y, camera.position.z);
                    ent.head.lookAt(camera.position.x, ent.head.position.y, camera.position.z);
                    
                    let forward = new THREE.Vector3(0, 0, -1).applyQuaternion(ent.body.quaternion);
                    let right = new THREE.Vector3(1, 0, 0).applyQuaternion(ent.body.quaternion);
                    ent.gun.position.copy(ent.body.position).addScaledVector(right, 0.3).addScaledVector(forward, 0.2);
                    ent.gun.quaternion.copy(ent.body.quaternion);

                    if(!(ent.stunTimeLeft > 0) && dist < 22 && worldClock - ent.lastShot > (ent.isMinion ? 1.2 : 1.6)) {
                        enemyShoot(ent, false); ent.lastShot = worldClock;
                    }
                });
                updateTD(delta, worldDelta);

                if (goalMesh) goalMesh.rotation.y += 2.0 * delta;
                if (waypointBeaconMesh) waypointBeaconMesh.rotation.y -= 0.5 * delta;
                gems.forEach(g => { g.rotation.y += 2 * delta; g.position.y = 1.2 + Math.sin(clock.getElapsedTime() * 5) * 0.08; });

                if (goalMesh && camera.position.distanceTo(goalMesh.position) < 1.8) openUpgradeMenu();
            }
            renderer.render(scene, camera);
        }

        function onWindowResize() {
            camera.aspect = window.innerWidth / window.innerHeight; camera.updateProjectionMatrix();
            renderer.setSize(window.innerWidth, window.innerHeight);
        }
    </script>
</body>
</html>