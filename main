        // --- Game modes / shop / tower defense state ---
        // Declared this early on purpose: animate() starts running at the top
        // of the script, so anything it (or code it calls) reads must already
        // be initialised.
        // =====================================================================
        let gameMode = 'CLASSIC';              // 'CLASSIC' | 'SHOP' | 'TD'
        let kiraSlowDuration = KIRA_TIME_SLOW_DURATION; // upgradeable copy of the constant
        let baseFogDensity = 0.045;            // fog level before the Map Vision upgrade (TD uses a clearer arena)

        let shopLoadout = { skill: null, ult: null }; // what the player owns in Blank Slate / Crystal Defense
        let shopSpent = {};                    // key -> total points invested (for the 50% sell refund)
        let shopItemTier = {};                 // key -> upgrade level of an owned skill/ult

        // Shop skills (E). Each one reuses the exact functions the roles use.
        const SHOP_SKILLS = {
