    <script>
        // =====================================================================
        // PC / MOBILE BUILD FLAG
        // The PC and mobile files are the SAME code; the only difference is
        // this constant (false = keyboard + mouse, true = touch controls,
        // phone HUD layout, aim assist, no antialiasing). Edit one file,
        // flip this to get the other.
        // =====================================================================
        const IS_MOBILE = true;
        const mobileMove = { x: 0, y: 0 };   // virtual joystick: x = right, y = forward, both -1..1
        let mobileSens = 1.0;                // look sensitivity multiplier (pause-menu slider)

        // Wall boxes never move, so compute each one once instead of every
        // frame for every bullet/enemy/player check.
        const _wallBoxCache = new WeakMap();
        function wallBox(obj) {
            let b = _wallBoxCache.get(obj);
            if (!b) { b = new THREE.Box3().setFromObject(obj); _wallBoxCache.set(obj, b); }
            return b;
        }

        let scene, camera, clock = new THREE.Clock();
        let renderer;
        let gameState = "MENU"; 
        let selectedRole = "SHOTGUNNER";
        let menuRotationAngle = 0;

        // =====================================================================
        // ROLE SYSTEM NOTE:
        // This game has two playable roles, SHOTGUNNER and ASSASSIN, selected
        // via selectedRole. Shared fields (movement, health, ult charge) are
        // used by both. Fields/blocks below are explicitly tagged "Shotgunner
        // Specific" or "Assassin Specific" wherever the game logic diverges
        // by role, so it's easier to find/edit one role without touching
        // the other.
        // =====================================================================

        let player = {
            // --- Shared (both roles) ---
            height: 1.6, baseSpeed: 7.5, speed: 7.5,
            currentMoveVel: new THREE.Vector3(), velocity: new THREE.Vector3(), 
            timeLeft: 40, score: 0, health: 100, maxHealth: 100,
            isGrounded: true, yVelocity: 0, jumpForce: 11.0, gravity: 28.0, currentHeight: 1.6,
            ultCharge: 0, ultRequiredKills: 5, beaconTimeLeft: 0,
            fireRateModifier: 1.0, damageModifier: 1.0, killSpeedBonusPct: 0, slowTimeLeft: 0,

            // --- Shotgunner Specific: Kinetic Dash [E] ---
            dashMomentum: new THREE.Vector3(), dashCooldown: 0, dashMultiplier: 1.0, dashCooldownMax: 4.0,

            // --- Assassin Specific: Phantom Rush [E] ---
            phantomWindowMax: 3.0,             // current Phantom Rush window length (shop upgrades raise it)
            phantomActive: false,              // true while the hyper-speed window is running
            phantomCdLeft: 0,                  // seconds left before Phantom Rush can be used again
            phantomWindowTimeLeft: 0,          // seconds left in the current hyper-speed window
            phantomKilledDuringWindow: false,  // did any katana kill land while this window was active?
            ultCastEffectTimeLeft: 0,          // Blade Wave's brief slow+zoom cast punch
            phantomSpeedBoostTimeLeft: 0,      // seconds left on the post-window 20% speed boost

            // --- Jumper Specific: Warp Blink [E] + Gravity Slam ultimate [F] ---
            jumperBlinkCdMax: 3.0,               // Warp Blink cooldown (shop upgrades lower it)
            jumperBlinkRange: 14,                // current max aim-cast range (upgradeable); matches JUMPER_AIM_MAX_RANGE_BASE below
            jumperBlinkCdLeft: 0,                // seconds left before Warp Blink can be used again
            jumperAimHeld: false,      // E hold-state
            jumperMarkerX: 0, jumperMarkerZ: 0, jumperMarkerDist: 0, jumperMarkerValid: false,
            jumperUltAimHeld: false, // F hold-state
            jumperUltMarkerX: 0, jumperUltMarkerZ: 0, jumperUltMarkerValid: false,

            // --- Kira Specific: Death Note ---
            kiraTypedBuffer: ""
        };

        let onKillBuffs = { killCount: 0, timer: 0 };

        // Weapon 1 = Shotgunner sidearm, 2 = Assassin melee, 3 = Shotgunner primary,
        // 4 = Shotgunner ultimate, 5 = Assassin ultimate.
        const WEAPONS = {
            1: { name: "INFINITY PISTOL", damage: 40, fireRate: 0.25, lastFired: 0, color: 0x00ffff, size: [0.07, 0.07, 0.35], projectileSpeed: 65, reserve: Infinity, recoil: { pitch: 0.018, yaw: 0.010 } }, // Shotgunner sidearm
            2: { name: "CYBER KATANA", damage: 180, fireRate: 0.32, lastFired: 0, color: 0x00ffaa, range: 4.2 }, // Assassin melee weapon (no recoil -- not a gun)
            3: { name: "CYBER SHOTGUN", damage: 20, fireRate: 0.75, lastFired: 0, color: 0x00ff55, size: [0.14, 0.12, 0.6], projectileSpeed: 55, pelletCount: 9, spread: 0.14, reserve: 15, maxReserve: 40, recoil: { pitch: 0.045, yaw: 0.022 } }, // Shotgunner primary
            4: { name: "HYPER RPG", damage: 450, fireRate: 0.5, lastFired: 0, color: 0xff3300, size: [0.22, 0.22, 0.95], projectileSpeed: 38, splashRadius: 4.0, recoil: { pitch: 0.09, yaw: 0.018 } }, // Shotgunner ultimate
            5: { name: "BLADE WAVE", damage: 500, width: 4.5, speed: 35.0 }, // Assassin ultimate (no recoil -- not a gun)
            6: { name: "PHASE CARBINE", damage: 18, fireRate: 0.1, lastFired: 0, color: 0x9d4bff, size: [0.09, 0.09, 0.62], projectileSpeed: 55, reserve: Infinity, recoil: { pitch: 0.012, yaw: 0.016 } }, // Jumper primary
            7: { name: "GRAVITY SLAM", damage: 65, radius: 6 }, // Jumper ultimate -- stats only, not a fired "weapon" (see fireGravitySlamUltimate)
            8: { name: "DEATH NOTE", fireRate: 0.1, lastFired: 0, reserve: Infinity } // Kira's "weapon" -- purely cosmetic, M1 does nothing (see shoot())
        };
        let currentWeaponId = 3, isShooting = false, savedWeaponBeforeUlt = 3;

        // --- Shared: Gun Recoil ---
        // Any weapon with a WEAPONS[x].recoil entry kicks the camera up
        // (and slightly sideways at random) on every shot; recoilPitch/
        // recoilYaw track how much of the current camera angle is still
        // "owed" back to recoil recovery, decayed each frame in animate().
        // Melee/wave weapons (Katana, Blade Wave) have no recoil entry and
        // are unaffected. A future gun-toting role just adds its own
        // WEAPONS[x].recoil and gets this for free.
        let recoilPitch = 0, recoilYaw = 0;
        const RECOIL_MAX_PITCH = 0.4;      // hard cap so sustained fire can't spiral the view uncontrollably
        const RECOIL_RECOVERY_SPEED = 8.0; // how fast the kick settles back down

        function applyRecoilKick(recoilCfg) {
            if (!recoilCfg) return;

            let prevPitch = recoilPitch;
            recoilPitch = Math.min(recoilPitch + recoilCfg.pitch, RECOIL_MAX_PITCH);
            let actualPitchAdded = recoilPitch - prevPitch;
            camera.rotation.x = Math.max(-Math.PI / 2.3, Math.min(Math.PI / 2.3, camera.rotation.x + actualPitchAdded));

            let kickYaw = (Math.random() - 0.5) * 2 * recoilCfg.yaw;
            recoilYaw += kickYaw;
            camera.rotation.y += kickYaw;
        }

        // --- Assassin Specific: Phantom Dash tuning ---
        const PHANTOM_WINDOW_DURATION = 3.0;   // seconds the hyper-speed window lasts; a kill refreshes it back to this
        const PHANTOM_HYPER_SPEED_MULT = 2.5;  // move speed multiplier while the window is active
        const PHANTOM_MISS_COOLDOWN = 7.0;     // cooldown (s) applied only if the window ends having landed zero kills total
        const PHANTOM_SPEED_BOOST_MULT = 1.2;  // 20% move speed boost granted after any Phantom Rush use
        const PHANTOM_SPEED_BOOST_DURATION = 2.5; // how long that boost lasts (s)
        const ASSASSIN_ULT_FX_DURATION = 0.4;  // seconds the Blade Wave cast punch (slow + zoom) lasts
        const ASSASSIN_ULT_FX_FOV = 35;        // zoomed-in FOV during the punch
        const ASSASSIN_ULT_FX_SPEED_MULT = 0.25; // player move speed is cut to this fraction during the punch

        // --- Role Config Table ---
        // Central place describing each playable role's kit. To add a new
        // role: give it a ROLES entry here, its weapon(s) in WEAPONS, its
        // upgrades in UPGRADE_REGISTRY (roles: ["NEWROLE"]), any new
        // player-state fields it needs, its own skill/ultimate functions
        // (tagged "NEWROLE Specific" like the ones below), and a role-card
        // in the menu HTML with a matching data-role attribute. Everything
        // else -- skill keys, weapon hotkeys, per-frame skill update, the
        // ultimate trigger, and base movement speed -- reads from this
        // table instead of hardcoded "if (selectedRole === ...)" checks,
        // so none of those call sites need to change for a new role.
        const ROLES = {
            SHOTGUNNER: {
                baseSpeed: 7.5,
                defaultWeaponId: 3,
                weaponSlots: { 1: 1, 3: 3 },   // Digit1 -> pistol, Digit3 -> shotgun
                onSkillE: () => triggerKineticDash(),
                onSkillQ: null,                 // Overclock was removed
                onKill: () => { player.dashCooldown = 0; }, // a kill instantly refreshes Kinetic Dash
                updateSkill: (delta, skillElement) => updateShotgunnerSkill(delta, skillElement),
                onUltimate: () => fireRpgUltimateAnimation()
            },
            ASSASSIN: {
                baseSpeed: 7.0,
                defaultWeaponId: 2,
                weaponSlots: { 1: 2 },         // Digit1 -> katana (no Digit3 weapon)
                onSkillE: () => triggerPhantomDash(),
                onSkillQ: null,                 // no secondary skill for this role
                onKill: () => onPhantomKill(),  // any kill while Rush is active refreshes it
                updateSkill: (delta, skillElement) => updateAssassinSkill(delta, skillElement),
                onUltimate: () => fireBladeWaveUltimate()
            },
            JUMPER: {
                baseSpeed: 8.5,
                defaultWeaponId: 6,
                weaponSlots: { 1: 6 },         // Digit1 -> Phase Carbine (no Digit3 weapon)
                onSkillE: () => startJumperBlinkAim(),
                onSkillERelease: () => confirmJumperBlinkAim(),
                onSkillQ: null,                 // no secondary skill for this role
                updateSkill: (delta, skillElement) => updateJumperSkill(delta, skillElement),
                holdableUltimate: true,          // Gravity Slam is aimed like the blink -- charge is only spent on a valid release
                onUltimateHoldStart: () => startJumperUltimateAim(),
                onUltimateHoldRelease: () => confirmJumperUltimateAim()
            },
            KIRA: {
                baseSpeed: 7.5,
                defaultWeaponId: 8,
                weaponSlots: {},                 // no weapon-switch keys -- Digit0-9 are the Death Note input instead (see keydown handler)
                onSkillE: null,                  // no E skill for this role
                onSkillQ: null,                  // no secondary skill for this role
                updateSkill: (delta, skillElement) => updateKiraSkill(delta, skillElement),
                onUltimate: () => fireHyperCognitionUltimate()
            },
            // Blank Slate / Crystal Defense: a pseudo-role whose skill and
            // ultimate come from whatever the player bought in the shop.
            SHOP: {
                baseSpeed: 7.5,
                defaultWeaponId: 1,
                get weaponSlots() { const s = { 1: 1 }; shopWeapons.forEach((id, i) => { s[i + 2] = id; }); return s; },
                get onSkillE() { const s = shopSkillDef(); return s ? s.onE : null; },
                get onSkillERelease() { const s = shopSkillDef(); return (s && s.onERelease) ? s.onERelease : null; },
                onSkillQ: null,
                onKill: () => { const s = shopSkillDef(); if (s && s.onKill) s.onKill(); },
                updateSkill: (delta, skillElement) => updateShopLoadout(delta, skillElement),
                get holdableUltimate() { const u = shopUltDef(); return !!(u && u.holdable); },
                get onUltimate() { const u = shopUltDef(); return u ? u.onUltimate : null; },
                get onUltimateHoldStart() { const u = shopUltDef(); return u ? u.onHoldStart : null; },
                get onUltimateHoldRelease() { const u = shopUltDef(); return u ? u.onHoldRelease : null; }
            }
        };

        // --- Jumper Specific: Warp Blink [E] / Gravity Slam [F] aim-cast tuning ---
        // Both abilities share the exact same targeting: hold the key, a
        // marker slides out along the floor plane (ignores camera pitch, so
        // it always tracks a flat direction) up to player.jumperBlinkRange,
        // and is green when the current tip is a legal destination or red
        // when it's inside a wall / outside the maze. E warps the player
        // there; F instead detonates Gravity Slam's AoE there on release.
        const JUMPER_AIM_MAX_RANGE_BASE = 14;   // un-upgraded max marker distance ("Warp Extender" upgrade adds to this) -- lowered from 22, felt too strong unupgraded
        const JUMPER_SLAM_STUN_DURATION = 3.0;  // seconds enemies hit (and not killed) by Gravity Slam can't shoot
        const JUMPER_BLINK_COOLDOWN = 3.0;      // seconds before Warp Blink can be used again after a successful blink

        const BASE_ENEMY_HP = 50;
        const BASE_ENEMY_DMG = 10;
        const HP_GROWTH_PER_STAGE = 6;      
        const DMG_GROWTH_PER_STAGE = 1.5;   
        let initialSpawnChance = 0.25;      
        let spawnChanceGrowth = 0.03;       

        let objects = [], gems = [], enemies = [], playerBullets = [], enemyBullets = [], healthPickups = [], locators = [], waveProjectiles = [], activeSlashEffects = [], activeSlamEffects = [];

        // --- Kira Specific: time-slow ultimate state ---
        // Declared up here (rather than down with the rest of Kira's code)
        // because animate() reads kiraTimeSlowTimeLeft/worldClock on every
        // frame and animate() is first invoked near the top of the script
        // (to drive the main-menu background) -- a `let` declared later in
        // the file is still in its temporal dead zone at that point, which
        // was throwing "Cannot access before initialization".
        const KIRA_TIME_SLOW_DURATION = 6.0;  // seconds the world stays slowed
        const KIRA_TIME_SLOW_FACTOR = 0.25;   // world runs at this fraction of normal speed while slowed
        let kiraTimeSlowTimeLeft = 0;
