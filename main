        let upgradeTiers = {
            sgDamage: 0, sgPellets: 0, sgSpread: 0, sgFireRate: 0, rpgRadius: 0,
            katanaDamage: 0, katanaReflect: 0, phantomDamage: 0, phantomRange: 0, waveDamage: 0, waveWidth: 0,
            pistolDamage: 0, pistolFireRate: 0, jumperGunDamage: 0, jumperBlinkRange: 0, jumperUltDamage: 0, jumperUltRadius: 0,
            dashForce: 0, dashDamage: 0, killFireRate: 0, killDamage: 0, killSpeed: 0,
            nanoSiphon: 0, playerSpeed: 0, farVision: 0, maxHealth: 0
        };

        function getTierBonus(t, baseIncrement) {
            if (t <= 0) return 0;
            return (t * (t + 1) / 2) * baseIncrement;
        }

        // Max kill-streak stacks a "per kill" upgrade (killFireRate/
        // killDamage/killSpeed) can benefit from, at a given tier.
        // Grows with tier so a streak can't scale forever off one cheap buy.
        function getKillBuffCap(tier) {
            return tier > 0 ? (3 + tier * 2) : 0;
        }

        function getAddedIncrement(t, baseIncrement) {
            return (t + 1) * baseIncrement;
        }

