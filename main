        // --- Shared: bullet count cap ---
        // Hard ceiling on how many of each bullet type can exist at once.
        // Spawning past the cap removes the oldest bullet of that type (it is
        // almost certainly near the end of its life) instead of letting the
        // array -- and the per-frame collision checks against it -- grow
        // without bound.
        const MAX_PLAYER_BULLETS = 60;
        const MAX_ENEMY_BULLETS = 60;

        function pushPlayerBullet(bulletData) {
            if (playerBullets.length >= MAX_PLAYER_BULLETS) {
                let oldest = playerBullets.shift();
                scene.remove(oldest.mesh);
            }
            playerBullets.push(bulletData);
        }

        function pushEnemyBullet(bulletData) {
            if (enemyBullets.length >= MAX_ENEMY_BULLETS) {
                let oldest = enemyBullets.shift();
                scene.remove(oldest.mesh);
            }
            enemyBullets.push(bulletData);
        }
        let mazeSize = 11, currentLevel = 1, cellSize = 6, mazeOffset = 0, rawGrid = [];
